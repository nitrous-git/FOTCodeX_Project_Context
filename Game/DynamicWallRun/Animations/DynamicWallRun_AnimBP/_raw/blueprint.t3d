      Begin Object Name="EdGraphNode_Comment_11" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/DynamicWallRun/Animations/DynamicWallRun_AnimBP.DynamicWallRun_AnimBP:AnimGraph.EdGraphNode_Comment_11'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         NodePosX=32
         NodePosY=-464
         NodeWidth=816
         NodeHeight=608
         NodeComment="This blend\'s only purpose is to keep the main character AnimBP result \"relevant\" so that its state machine doesn\'t reset to the beginning when we return to it. This allows the character\'s own landing animation to play when a wall-jump ends. Aside from this, the blend changes nothing - it\'s blending all bones 100% to the desired wall run animations.\r\n\r\nThis isn\'t needed for earlier engine versions (such as 4.18), but became necessary for later versions.\r\n\r\nThis work-around was suggested by an Epic employee here:\r\nhttps://answers.unrealengine.com/questions/429770/blend-states-resetting-after-playing-a-montage.html"
         NodeGuid=AE11CFDB4895C2219767AD8B35FB1EF7
      End Object
