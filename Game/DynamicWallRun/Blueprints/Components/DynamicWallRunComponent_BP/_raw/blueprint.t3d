      Begin Object Name="EdGraphNode_Comment_13" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:DetectWall.EdGraphNode_Comment_13'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         NodePosX=6704
         NodePosY=1184
         NodeWidth=1024
         NodeHeight=672
         NodeComment="Backup / Corner trace - If the Secondary trace did not detect a surface, this trace checks for the possibility of an extremely sharp outside corner (~90 degrees). To detect sharp corners, the trace starts slightly past where the corner would be, then traces sharply backwards."
         NodeGuid=F472CA424D120E08DD14C79093AB7C7B
      End Object
      Begin Object Name="EdGraphNode_Comment_211" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:DetectWall.EdGraphNode_Comment_211'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         CommentDepth=-2
         NodePosX=4727
         NodePosY=-189
         NodeWidth=1168
         NodeHeight=704
         NodeComment="Secondary trace - Looks for a wall a short distance in front of the player to identify any upcoming turns/corners. The positions of this trace are based on information gathered from the previous trace - it uses the impact point and wall normal from the previous trace to start a short distance forward and away from the wall, then traces in the reverse direction of that wall\'s normal (towards the wall). The end position is moved slightly forward to better detect inside corners."
         NodeGuid=7832E5824BC8E022D4927F8B2DB87CB7
      End Object
      Begin Object Name="EdGraphNode_Comment_8" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:DetectWall.EdGraphNode_Comment_8'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         NodePosX=2864
         NodePosY=224
         NodeWidth=768
         NodeHeight=320
         NodeComment="If no eligible hit was detected and the character is currently wall running, it means the player has lost contact with the wall (most likely from running off the edge). Stop the wall run immediately."
         NodeGuid=4DD93427416D1F9471353A807021BB2B
      End Object
      Begin Object Name="EdGraphNode_Comment_7" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:DetectWall.EdGraphNode_Comment_7'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         NodePosX=2985
         NodePosY=-118
         NodeWidth=816
         NodeHeight=224
         NodeComment="Record the impact normal as the PrimaryTraceNormal and as the AverageWallNormal, the latter of which may be modified in future steps. We also record the location of the wall for future reference."
         NodeGuid=743F3334427DBE52B55B74A278E81EB9
      End Object
      Begin Object Name="EdGraphNode_Comment_5" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:DetectWall.EdGraphNode_Comment_5'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         CommentDepth=-2
         NodePosX=161
         NodePosY=-124
         NodeWidth=1792
         NodeHeight=960
         NodeComment="Primary trace - look for a wall to the left or right of the character (depending on which side was provided when the function was called). The trace begins at the character\'s location and ends a short distance to the character\'s left or right."
         NodeGuid=D2E7D82E4ADBA4D8FE208B8A3BD04E7C
      End Object
