      Begin Object Name="EdGraphNode_Comment_5" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:TopHeightCheck.EdGraphNode_Comment_5'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         NodePosX=1904
         NodePosY=-96
         NodeWidth=2832
         NodeHeight=416
         NodeComment="If the impact point is below the trace\'s start location (indicating that the player is higher than desired), and the player is currently wall-running, lower the player by the difference (how high above the wall they are) to place them at the desired max height for the current wall."
         NodeGuid=19B070104E6E9589CF70AC8DF897A0C0
      End Object
