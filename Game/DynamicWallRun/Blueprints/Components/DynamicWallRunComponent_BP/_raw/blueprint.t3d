   Begin Object Name="StartWallRun" ExportPath="/Script/Engine.EdGraph'/Game/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:StartWallRun'"
      Begin Object Name="EdGraphNode_Comment_84" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:StartWallRun.EdGraphNode_Comment_84'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         NodePosX=8624
         NodePosY=-187
         NodeWidth=672
         NodeHeight=352
         NodeComment="Clear any existing velocity on the character so that the wall run always behaves consistently (otherwise the run\'s distance/height could be affected by the velocity the character had when the run began). This also prevents old velocity values from negatively affecting the arc angle animation blend, which is based on velocity."
         NodeGuid=C6F7E4634D1177B5D888608EF4BE4B5F
      End Object
