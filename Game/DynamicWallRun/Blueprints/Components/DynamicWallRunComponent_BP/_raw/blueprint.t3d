      Begin Object Name="EdGraphNode_Comment_7" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:WallRunTick.EdGraphNode_Comment_7'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         NodePosX=2496
         NodePosY=-128
         NodeWidth=1536
         NodeHeight=624
         NodeComment="Smoothly rotate the character so it faces the direction the wallrun is going. The RInterp Speed increases proportionally with the character\'s velocity so that higher speeds = faster turning. This makes high speed turns look nicer, and also helps the system track corners better at high speed."
         NodeGuid=D5AA95944BB034B8642D2A8624BF5BC5
      End Object
