      Begin Object Name="EdGraphNode_Comment_394" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:CheckCornerAngle.EdGraphNode_Comment_394'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         NodePosX=320
         NodePosY=384
         NodeWidth=1632
         NodeHeight=416
         NodeComment="Determines whether we\'re evaluating an inside or outside corner and returns the appropriate angle limit. We identify which way the wall is turning by getting the cross product of the two surface normals (negative z = turning left, positive z = turning right). Combining that with which side of the character the wall is on tells us if we\'re navigating an inside or outside corner."
         NodeGuid=F406306640DB421C0DE64DA75CB2186C
      End Object
      Begin Object Name="EdGraphNode_Comment_20" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:CheckCornerAngle.EdGraphNode_Comment_20'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         NodePosX=848
         NodePosY=64
         NodeWidth=1008
         NodeHeight=272
         NodeComment="Chop off the decimal to prevent slight inaccuracies from causing wallruns to end (for example, flat walls would sometimes report 0.02 instead of 0 - which would cause a wall run to end incorrectly if the max corner angle was set to 0.\r\n\r\nThis does mean there\'s about 1 more degree being allowed than desired (if max angle is 45, this would allow 45.9 to proceed), but I think it\'s the most elegant solution."
         NodeGuid=CB5A62464BB5803503CF55B30722F315
      End Object
