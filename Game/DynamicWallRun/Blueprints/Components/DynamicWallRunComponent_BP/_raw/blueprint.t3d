      Begin Object Name="EdGraphNode_Comment_1" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:StartWallRun.EdGraphNode_Comment_1'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         CommentDepth=-2
         NodePosX=704
         NodePosY=-266
         NodeWidth=1520
         NodeHeight=672
         NodeComment="Only allow the wall run to begin if:\r\n- The player character was moving in the direction of the wall during the previous tick (we use the previous tick\'s velocity because if the wall detection trace is triggered during the same tick that the character\'s capsule hits the wall, the current velocity reflects the post-impact velocity, which is not useful to us here)\r\nOR\r\n- The player is providing movement input in the direction of the wall\r\n\r\nIf the result of the dot products are negative, the character (or its input vector) is moving towards the wall. If it\'s positive, they\'re moving away from the wall."
         NodeGuid=F6391F244D0AE77235DF16BD34176B4A
      End Object
