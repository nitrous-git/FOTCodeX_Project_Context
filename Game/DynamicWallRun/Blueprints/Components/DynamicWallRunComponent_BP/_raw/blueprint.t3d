      Begin Object Name="EdGraphNode_Comment_8" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:TopHeightCheck.EdGraphNode_Comment_8'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         NodePosX=-105
         NodePosY=-116
         NodeWidth=1184
         NodeHeight=704
         NodeComment="In the event that the line trace fails to detect a wall, we perform a backup capsule trace. The additional size of this capsule trace is more likely to find where the top ledge of the wall is, but that also means it\'s more likely to find false positives, which is why this is only done if the first trace fails."
         NodeGuid=8F04BDF74E3E4B6742B62D98BD769AD7
      End Object
      Begin Object Name="EdGraphNode_Comment_6" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:TopHeightCheck.EdGraphNode_Comment_6'"
