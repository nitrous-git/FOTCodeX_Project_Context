      Begin Object Name="EdGraphNode_Comment_9" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:WallRunTick.EdGraphNode_Comment_9'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         NodePosX=160
         NodePosY=-96
         NodeWidth=368
         NodeHeight=224
         NodeComment="Only perform these updates if we\'re currently wall running."
         NodeGuid=E6E811214ECFC1B6C21E02B617E1293B
      End Object
      Begin Object Name="EdGraphNode_Comment_8" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:WallRunTick.EdGraphNode_Comment_8'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         NodePosX=1019
         NodePosY=-250
         NodeWidth=1440
         NodeHeight=592
         NodeComment="Add movement input to the character in the direction of the desired wall run. We get the movement direction by finding the cross product of the AverageWallNormal and the up/down vectors (up or down depending on which side of the character the wall is on).\r\n\r\nThe Scale Value is set very high so that it dwarfs/overrides any manual input being applied by the player. This method may seem odd, but it\'s much simpler than having to add logic to the character BP to filter the player\'s movement inputs at the appropriate times (which would make merging the system into other characters more complicated)."
         NodeGuid=7725DE21403879A584E87E9597CEAC46
      End Object
      Begin Object Name="K2Node_Knot_19" ExportPath="/Script/BlueprintGraph.K2Node_Knot'/Game/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:WallRunTick.K2Node_Knot_19'"
