  "nodes": [
    {
      "name": "EdGraphNode_Comment_19",
      "class": "/Script/UnrealEd.EdGraphNode_Comment",
      "guid": "E930A4044AB50767D2E55BA3A1AE6363",
      "title": "EdGraphNode_Comment",
      "position": {
        "x": -49,
        "y": -132
      },
      "comment": "Get the WallRunComponent via the Interface, then call its StartWallJump function if successful. The function will only perform a wall jump if it is appropriate to do so. If a jump is performed, the output pin is not used, preventing any further action from being taken. The output pin is only used if a wall jump is not performed, allowing the player\\'s standard jump functions to be processed instead.",
      "enabled_state": "Enabled",
      "is_intermediate": false,
      "references": {},
      "properties": {},
      "pins": []
    },
