         ShowPinForProperties(8)=(PropertyName="bLoop",PropertyFriendlyName="Loop",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_BlendSpacePlayer:bLoop", "Should the animation loop back to the start when it reaches the end?"),CategoryName="Settings",bCanToggleVisibility=True)
