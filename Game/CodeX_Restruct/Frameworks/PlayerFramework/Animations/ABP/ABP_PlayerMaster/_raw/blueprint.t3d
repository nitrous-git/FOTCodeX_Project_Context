         ShowPinForProperties(0)=(PropertyName="GroupName",PropertyFriendlyName="Group Name",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_SequencePlayer:GroupName", "The group name that we synchronize with (NAME_None if it is not part of any group)."),CategoryName="Sync")
