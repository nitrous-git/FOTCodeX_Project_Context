         ShowPinForProperties(0)=(PropertyName="GroupName",PropertyFriendlyName="Group Name",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_BlendSpacePlayer:GroupName", "The group name that we synchronize with (NAME_None if it is not part of any group). Note that\nthis is the name of the group used to sync the output of this node - it will not force\nsyncing of animations contained by it."),CategoryName="Sync",bCanToggleVisibility=True)
         ShowPinForProperties(1)=(PropertyName="GroupRole",PropertyFriendlyName="Group Role",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_BlendSpacePlayer:GroupRole", "The role this node can assume within the group (ignored if GroupName is not set). Note\nthat this is the role of the output of this node, not of animations contained by it."),CategoryName="Sync",bCanToggleVisibility=True)
         ShowPinForProperties(2)=(PropertyName="bOverridePositionWhenJoiningSyncGroupAsLeader",PropertyFriendlyName="Override Position when Joining Sync Group as Leader",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_BlendSpacePlayer:bOverridePositionWhenJoiningSyncGroupAsLeader", "When enabled, acting as the leader, and using marker-based sync, this asset player will not sync to the previous leader\'s sync position when joining a sync group and before becoming the leader but instead force everyone else to match its position."),CategoryName="Sync",bCanToggleVisibility=True)
         ShowPinForProperties(3)=(PropertyName="Method",PropertyFriendlyName="Method",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_BlendSpacePlayer:Method", "How this node will synchronize with other animations. Note that this determines how the output\nof this node is used for synchronization, not of animations contained by it."),CategoryName="Sync",bCanToggleVisibility=True)
