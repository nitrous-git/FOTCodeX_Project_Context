      Begin Object Name="EdGraphNode_Comment_5" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:TopHeightCheck.EdGraphNode_Comment_5'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         NodePosX=1904
         NodePosY=-96
         NodeWidth=2832
         NodeHeight=416
         NodeComment="If the impact point is below the trace\'s start location (indicating that the player is higher than desired), and the player is currently wall-running, lower the player by the difference (how high above the wall they are) to place them at the desired max height for the current wall."
         NodeGuid=63B52DFA470703E30457449167FFBAAC
      End Object
      Begin Object Name="EdGraphNode_Comment_6" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:TopHeightCheck.EdGraphNode_Comment_6'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         NodePosX=1136
         NodePosY=-84
         NodeWidth=496
         NodeHeight=336
         NodeComment="Perform different actions depending on whether the trace finds an eligible wall."
         NodeGuid=A06EA04D4102C0B1A2B40D8664FB08CD
      End Object
      Begin Object Name="EdGraphNode_Comment_8" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:TopHeightCheck.EdGraphNode_Comment_8'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         NodePosX=-105
         NodePosY=-116
         NodeWidth=1184
         NodeHeight=704
         NodeComment="In the event that the line trace fails to detect a wall, we perform a backup capsule trace. The additional size of this capsule trace is more likely to find where the top ledge of the wall is, but that also means it\'s more likely to find false positives, which is why this is only done if the first trace fails."
         NodeGuid=B8D008F540B1310101EE3FA7B420C3E1
      End Object
