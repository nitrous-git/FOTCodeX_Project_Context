      Begin Object Name="EdGraphNode_Comment_9" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:TopHeightCheck.EdGraphNode_Comment_9'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         NodePosX=-286
         NodePosY=614
         NodeWidth=1696
         NodeHeight=800
         NodeComment="If the previous trace doesn\'t detect a wall, it means the character moved up a significant distance from the previous frame (most likely due to extremely low FPS), causing us to lose the wall entirely. If this happens, perform a failsafe trace that tries to find the top ledge of the wall by starting above it and tracing downwards. This will rarely ever be used unless your framerate drops to near unplayable levels."
         NodeGuid=D0F1ED8B4C3A958CCE7B00804F1651FE
      End Object
      Begin Object Name="EdGraphNode_Comment_10" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:TopHeightCheck.EdGraphNode_Comment_10'"
