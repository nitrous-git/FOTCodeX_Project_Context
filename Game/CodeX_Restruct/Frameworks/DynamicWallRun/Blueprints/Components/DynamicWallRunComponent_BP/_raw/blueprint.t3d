      Begin Object Name="EdGraphNode_Comment_5" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:DetectWall.EdGraphNode_Comment_5'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         CommentDepth=-2
         NodePosX=161
         NodePosY=-124
         NodeWidth=1792
         NodeHeight=960
         NodeComment="Primary trace - look for a wall to the left or right of the character (depending on which side was provided when the function was called). The trace begins at the character\'s location and ends a short distance to the character\'s left or right."
         NodeGuid=D38DE4B04C3BBF58344FACA1C9F8DAB8
      End Object
      Begin Object Name="EdGraphNode_Comment_7" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:DetectWall.EdGraphNode_Comment_7'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         NodePosX=2985
         NodePosY=-118
         NodeWidth=816
         NodeHeight=224
         NodeComment="Record the impact normal as the PrimaryTraceNormal and as the AverageWallNormal, the latter of which may be modified in future steps. We also record the location of the wall for future reference."
         NodeGuid=F835EC3240891C9CF0D4A2A06BFE3949
      End Object
      Begin Object Name="EdGraphNode_Comment_8" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:DetectWall.EdGraphNode_Comment_8'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         NodePosX=2864
         NodePosY=224
         NodeWidth=768
         NodeHeight=320
         NodeComment="If no eligible hit was detected and the character is currently wall running, it means the player has lost contact with the wall (most likely from running off the edge). Stop the wall run immediately."
         NodeGuid=FBCB310746B70D2355ACE1A8E2541A24
      End Object
      Begin Object Name="EdGraphNode_Comment_211" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:DetectWall.EdGraphNode_Comment_211'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         CommentDepth=-2
         NodePosX=4727
         NodePosY=-189
         NodeWidth=1168
         NodeHeight=704
         NodeComment="Secondary trace - Looks for a wall a short distance in front of the player to identify any upcoming turns/corners. The positions of this trace are based on information gathered from the previous trace - it uses the impact point and wall normal from the previous trace to start a short distance forward and away from the wall, then traces in the reverse direction of that wall\'s normal (towards the wall). The end position is moved slightly forward to better detect inside corners."
         NodeGuid=9FA6EEF74F202843686AE69FDC706A96
      End Object
      Begin Object Name="EdGraphNode_Comment_13" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:DetectWall.EdGraphNode_Comment_13'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         NodePosX=6704
         NodePosY=1184
         NodeWidth=1024
         NodeHeight=672
         NodeComment="Backup / Corner trace - If the Secondary trace did not detect a surface, this trace checks for the possibility of an extremely sharp outside corner (~90 degrees). To detect sharp corners, the trace starts slightly past where the corner would be, then traces sharply backwards."
         NodeGuid=FD9610C44B7D386E82D71FBB6B03805B
      End Object
