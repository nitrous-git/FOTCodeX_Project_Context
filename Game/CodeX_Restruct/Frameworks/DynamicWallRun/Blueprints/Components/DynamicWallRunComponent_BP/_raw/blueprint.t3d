      Begin Object Name="EdGraphNode_Comment_79" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:TopHeightCheck.EdGraphNode_Comment_79'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         NodePosX=-3039
         NodePosY=-260
         NodeWidth=2048
         NodeHeight=816
         NodeComment="This function identifies if there is enough space on the wall near the top of the player\'s capsule for the character to latch on to. If there isn\'t enough room, we either:\r\n\r\n1. Prevent the wall run if one hasn\'t already begun\r\n2. If we are already wall-running, prevent the player from running up and off of the wall\'s top ledge (this could occur when the wall-run is arcing upwards, or if the ledge angles downward into the wall-run\'s path)\r\n\r\nWe start with a simple line trace because it\'s the least prone to giving false positives. The trace starts at the desired \"max height\" that the player\'s capsule should be relative to the top ledge of a wall (i.e. if the trace doesn\'t hit the wall, it suggests the player has gone too high), then moves towards the wall a short distance."
         NodeGuid=B18A26D741B9432F099573B8FFDE1989
      End Object
      Begin Object Name="EdGraphNode_Comment_81" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:TopHeightCheck.EdGraphNode_Comment_81'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         NodePosX=-946
         NodePosY=-84
         NodeWidth=720
         NodeHeight=288
         NodeComment="Perform different actions depending on whether the trace finds an eligible wall."
         NodeGuid=CE2224E343AEFFF80829C89CF2C5DC43
      End Object
      Begin Object Name="K2Node_Knot_63" ExportPath="/Script/BlueprintGraph.K2Node_Knot'/Game/CodeX_Restruct/Frameworks/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:TopHeightCheck.K2Node_Knot_63'"
         NodePosX=-32
