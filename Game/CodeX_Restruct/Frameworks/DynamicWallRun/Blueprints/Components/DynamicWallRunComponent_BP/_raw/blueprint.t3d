            Begin Object Name="EdGraphNode_Comment_118" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:EventGraph.K2Node_Composite_2.TimedEvents.EdGraphNode_Comment_118'"
               CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
               NodePosY=3984
               NodeWidth=1424
               NodeHeight=688
               NodeComment="After a short delay, apply the necessary movement settings for the wall jump. This delay allows the wall jump direction and velocity to establish itself before allowing the player to override the direction of the jump, guaranteeing consistency with the initial jump direction/velocity regardless of player input.\r\n\r\nAcceleration is scaled up along with the WallJumpAirControl parameter because setting AirControl on its own wasn\'t providing enough control during the jump."
               NodeGuid=B2BC74B544AEE4B662E258837A10D1B4
            End Object
