            Begin Object Name="EdGraphNode_Comment_283" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:EventGraph.K2Node_Composite_2.TimedEvents.EdGraphNode_Comment_283'"
               CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
               NodePosY=2592
               NodeWidth=1104
               NodeHeight=320
               NodeComment="Starts a timer that monitors the character\'s X and Y velocity at set intervals during a wall run. This is a failsafe to detect if the player gets stuck during a wall run and will cancel the run if they\'re stuck for two consecutive intervals. The SpeedTooLow boolean is set to false when monitoring begins and will be set to true if the test fails."
               NodeGuid=556F7A9149431FDAB6EF9E91D2FAEED7
            End Object
            Begin Object Name="EdGraphNode_Comment_4" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:EventGraph.K2Node_Composite_2.TimedEvents.EdGraphNode_Comment_4'"
               CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
               CommentDepth=-2
               NodePosX=274
               NodePosY=2951
               NodeWidth=2048
               NodeHeight=704
               NodeComment="Checks if the character\'s X/Y velocity is at least 25% of the desired run speed. If it is lower than that, that suggests the wall run is being blocked by something. The first time this happens, we only set SpeedTooLow to true to mark that it has failed the test once - but we don\'t want to do anything about it yet in case it\'s just a momentary drop in velocity. If the test fails again in the next interval, then we stop the wall run. If the test does not fail two times consecutively, we set SpeedTooLow back to false so the process can start over. The gate is just there to prevent us from resetting SpeedTooLow to false when it is already false."
               NodeGuid=AC2FCB934ACBF1F2E02FBDAE7EC1C567
            End Object
            Begin Object Name="EdGraphNode_Comment_299" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:EventGraph.K2Node_Composite_2.TimedEvents.EdGraphNode_Comment_299'"
               CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
               NodePosY=3696
               NodeWidth=640
               NodeHeight=240
               NodeComment="Called when a wall run ends. This just stops the timer that was started by the StartMonitoringSpeed event."
               NodeGuid=CDEB4C5D4A12876DE59E5C8984F35E30
            End Object
            Begin Object Name="K2Node_CustomEvent_0" ExportPath="/Script/BlueprintGraph.K2Node_CustomEvent'/Game/CodeX_Restruct/Frameworks/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:EventGraph.K2Node_Composite_2.TimedEvents.K2Node_CustomEvent_0'"
