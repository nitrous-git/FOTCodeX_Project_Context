      Begin Object Name="EdGraphNode_Comment_2" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:WallRunTick.EdGraphNode_Comment_2'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         NodePosX=4825
         NodePosY=-186
         NodeWidth=912
         NodeHeight=336
         NodeComment="Check if there is enough vertical space on the wall for the player to continue wall running. If the player is approaching the top ledge of a wall, this caps their vertical movement so they won\'t run up off the top of it. We then check if there\'s enough vertical space near the bottom of the character. If the bottom of the capsule starts to hang off the bottom of the wall, the run will be ended."
         NodeGuid=A5EB274A4B483207EBA0C8BD86BF4CDD
      End Object
      Begin Object Name="EdGraphNode_Comment_3" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:WallRunTick.EdGraphNode_Comment_3'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         NodePosX=4070
         NodePosY=-68
         NodeWidth=720
         NodeHeight=256
         NodeComment="Track the amount of time the current wall run has been active by incrementing the float by the World Delta."
         NodeGuid=CFEE732B417C75CDD86F568159CF508F
      End Object
      Begin Object Name="EdGraphNode_Comment_4" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:WallRunTick.EdGraphNode_Comment_4'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         NodePosX=5769
         NodePosY=-100
         NodeHeight=208
         NodeComment="Update any values that are only used for animation purposes."
         NodeGuid=5BC00A2642520C17C90B868DC5C466AC
      End Object
      Begin Object Name="EdGraphNode_Comment_5" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:WallRunTick.EdGraphNode_Comment_5'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         NodePosX=1056
         NodePosY=368
         NodeWidth=1104
         NodeHeight=384
         NodeComment="Add an arc to the wall run by adding a Z-component to the movement input. The Z-component is defined by taking the current wall run duration, mapping it to a range of 1 to -2 over a set amount of time, then multiplying it by the global ArcAmount scalar. The result is that the arc begins at 1 (upward), then smoothly transitions to -2 (downward) over time."
         NodeGuid=3C9CD2114723F00AD78390B2CEE74524
      End Object
