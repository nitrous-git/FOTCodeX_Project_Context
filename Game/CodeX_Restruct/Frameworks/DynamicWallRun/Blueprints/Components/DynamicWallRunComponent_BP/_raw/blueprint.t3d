      Begin Object Name="EdGraphNode_Comment_12" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:BottomHeightCheck.EdGraphNode_Comment_12'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         NodePosX=-192
         NodePosY=-144
         NodeWidth=1808
         NodeHeight=672
         NodeComment="Check if there\'s a valid wall near the character\'s feet. The trace begins near the bottom of the capsule, then moves a short distance towards the desired side of the character. The trace lengths and radius are based on the character\'s capsule size to support characters of different sizes.\r\n\r\nThis is done to prevent the character from continuing to wall run if the bottom half of their body is hanging off the bottom of a wall."
         NodeGuid=971D899649851923CB5AC38B7614C8F2
      End Object
