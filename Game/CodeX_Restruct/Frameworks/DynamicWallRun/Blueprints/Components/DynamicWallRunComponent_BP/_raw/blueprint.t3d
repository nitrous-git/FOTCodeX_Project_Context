      Begin Object Name="EdGraphNode_Comment_20" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:StartWallJump.EdGraphNode_Comment_20'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         NodePosX=-20
         NodePosY=-73
         NodeWidth=1056
         NodeHeight=304
         NodeComment="If the player is currently wall running, stop the wall run and proceed with the wall jump."
         NodeGuid=21695FC243F63C598A5AC3BD6AC99122
      End Object
      Begin Object Name="EdGraphNode_Comment_21" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:StartWallJump.EdGraphNode_Comment_21'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         NodePosX=464
         NodePosY=272
         NodeWidth=576
         NodeHeight=224
         NodeComment="If the player is not wall running, stop the function and return False to indicate no jump was performed."
         NodeGuid=9BD8074B4E09C546381B9D8B5E49F205
      End Object
      Begin Object Name="EdGraphNode_Comment_22" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:StartWallJump.EdGraphNode_Comment_22'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         NodePosX=1071
         NodePosY=-235
         NodeWidth=1408
         NodeHeight=656
         NodeComment="Perform the jump by launching the character with the desired direction/velocity. The direction is determined by taking the current AverageWallNormal (which points directly away from the wall) and rotating it based on the provided WallJumpAngle. The angle is mapped to a reverse range (from 90->0 to 0->90) because the provided angle assumes 0 = forward and 90 = perpendicular to the wall, but the wall normal we start with is already perpendicular to the wall. So if 90 degrees is provided, we do not rotate the vector.\r\n\r\nZ-velocity is provided separately as its own parameter."
         NodeGuid=AC03619841731FEB64CC5C8C7CD311F5
      End Object
      Begin Object Name="EdGraphNode_Comment_23" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:StartWallJump.EdGraphNode_Comment_23'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         NodePosX=2512
         NodePosY=-64
         NodeWidth=320
         NodeHeight=176
         NodeComment="Record that we are now in the WallJumping state"
         NodeGuid=F53FCEB34F98F42C281BC694E0327EFE
      End Object
      Begin Object Name="EdGraphNode_Comment_24" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:StartWallJump.EdGraphNode_Comment_24'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         NodePosX=2870
         NodePosY=-148
         NodeWidth=1360
         NodeHeight=352
         NodeComment="Disable OrientRotationToMovement so that we can manually control character rotation, then remove all air control. We then grant air control (if allowed via the parameter) after a short delay. This delay allows the wall jump direction and velocity to establish itself before allowing the player to override the direction of the jump, guaranteeing consistency with the initial jump direction/velocity regardless of player input."
         NodeGuid=81D90F03493B63C0DFE2FAB3746FC257
      End Object
