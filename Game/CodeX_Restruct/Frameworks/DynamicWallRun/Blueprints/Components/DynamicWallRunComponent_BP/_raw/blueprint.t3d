      Begin Object Name="EdGraphNode_Comment_1" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/DynamicWallRun/Blueprints/Components/DynamicWallRunComponent_BP.DynamicWallRunComponent_BP:UpdateAnimationValues.EdGraphNode_Comment_1'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         NodePosX=1875
         NodePosY=-100
         NodeWidth=2720
         NodeHeight=432
         NodeComment="Find how fast we\'re turning around an outside corner and map it to a range of 0-1. To do this, we get the delta of the character\'s current and previous rotation, map it to a range of -1 to 1, switch the sign depending on what side the wall is on (so that outside corners always result in a positive value), then clamp the value so it can\'t be below 0 because we aren\'t interested in the turn rate of inside corners. The turn rate float is then interpolated so that its value changes are smooth."
         NodeGuid=9E671BE74A8773548DF5509B7E327DF2
      End Object
      Schema="/Script/CoreUObject.Class'/Script/BlueprintGraph.EdGraphSchema_K2'"
