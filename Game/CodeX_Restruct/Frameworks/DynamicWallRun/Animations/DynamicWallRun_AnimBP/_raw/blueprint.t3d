      Begin Object Name="EdGraphNode_Comment_34" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/DynamicWallRun/Animations/DynamicWallRun_AnimBP.DynamicWallRun_AnimBP:AnimGraph.EdGraphNode_Comment_34'"
         CommentColor=(R=0.161928,G=0.548735,B=1.000000,A=1.000000)
         NodePosX=-2536
         NodePosY=-331
         NodeWidth=912
         NodeHeight=736
         NodeComment="This additive pose is an aid to help the hand position remain consistent during the arcing wall run blendspace. Without this, the hand will clip into the wall between 0 and 45 degrees in the blendspace.\r\n\r\nA different solution could be to use IK, but results would vary depending on the character mesh - some characters may look fine, other characters would result in elbow popping / over-extension. It would require the user to tweak the IK positioning for their individual character. This additive blend is a simpler solution that doesn\'t require the user to tweak anything."
         NodeGuid=7D25725C43B6B2295C6B34842C68D5D8
      End Object
