    {
      "name": "EdGraphNode_Comment_2",
      "class": "/Script/UnrealEd.EdGraphNode_Comment",
      "guid": "46DE9CD542BD4C52F6166E901D535173",
      "title": "EdGraphNode_Comment",
      "position": {
        "x": 1360,
        "y": -544
      },
      "comment": "The Director is a policy/selector layer; metrics is the simulation layer. \r\n\r\nDirector: just pass Now = GetGameTimeInSeconds into Director_Evaluate(Now)\r\n\r\nEverything Director does is based on absolute-time comparisons:\r\n\r\n    Now - LastStaggerTime >= StaggerCooldown\r\n\r\n    Now - LastDefenseTime >= DefenseCooldown\r\n\r\n    Now - LastDirectorActionTime >= MinSecondsBetweenDirectorActions\r\n\r\nThose comparisons do not require DeltaTime accumulation; they are already robust to timer jitter.",
      "enabled_state": "Enabled",
      "is_intermediate": false,
      "references": {},
      "properties": {},
      "pins": []
    },
