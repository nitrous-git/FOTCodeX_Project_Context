         Node=(Mode=Graph,SpineBones=((BoneName="spine_01"),(BoneName="spine_02"),(BoneName="spine_03"),(BoneName="spine_04"),(BoneName="spine_05"),(BoneName="ik_hand_root")),IKFootRootBone=(BoneName="ik_foot_root"),IKFootBones=((BoneName="ik_foot_l"),(BoneName="ik_foot_r")),DistributedBoneOrientationAlpha=0.750000,AlphaBoolBlend=(BlendOption=Linear))
         ShowPinForProperties(0)=(PropertyName="ComponentPose",PropertyFriendlyName="Component Pose",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_SkeletalControlBase:ComponentPose", "Input link"),CategoryName="Links",bShowPin=True)
         ShowPinForProperties(1)=(PropertyName="LODThreshold",PropertyFriendlyName="LOD Threshold",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_SkeletalControlBase:LODThreshold", "Max LOD that this node is allowed to run\nFor example if you have LODThreshold to be 2, it will run until LOD 2 (based on 0 index)\nwhen the component LOD becomes 3, it will stop update/evaluate\ncurrently transition would be issue and that has to be re-visited"),CategoryName="Performance",bCanToggleVisibility=True)
         ShowPinForProperties(2)=(PropertyName="AlphaInputType",PropertyFriendlyName="Alpha Input Type",CategoryName="Alpha")
         ShowPinForProperties(3)=(PropertyName="bAlphaBoolEnabled",PropertyFriendlyName="bEnabled",CategoryName="Alpha",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(4)=(PropertyName="Alpha",PropertyFriendlyName="Alpha",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_SkeletalControlBase:Alpha", "Current strength of the skeletal control"),CategoryName="Alpha",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(5)=(PropertyName="AlphaScaleBias",PropertyFriendlyName="Alpha Scale Bias",CategoryName="Alpha")
         ShowPinForProperties(6)=(PropertyName="AlphaBoolBlend",PropertyFriendlyName="Blend Settings",CategoryName="Alpha")
         ShowPinForProperties(7)=(PropertyName="AlphaCurveName",PropertyFriendlyName="Alpha Curve Name",CategoryName="Alpha",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(8)=(PropertyName="AlphaScaleBiasClamp",PropertyFriendlyName="Alpha Scale Bias Clamp",CategoryName="Alpha")
         ShowPinForProperties(9)=(PropertyName="Mode",PropertyFriendlyName="Mode",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_OrientationWarping:Mode", "Orientation warping evaluation mode (Graph or Manual)"),CategoryName="Evaluation")
         ShowPinForProperties(10)=(PropertyName="TargetTime",PropertyFriendlyName="Target Time",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_OrientationWarping:TargetTime", "Experimental. Orientation warping should do nothing if root motion velocity directions match capsule,\nhowever root motion can have multiple velocity directions. So we also check root motion\ndirection \'TargetTime\' in the future for matching direction to avoid temp orientation warps."),CategoryName="Experimental",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(11)=(PropertyName="OrientationAngle",PropertyFriendlyName="Orientation Angle",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_OrientationWarping:OrientationAngle", "The desired orientation angle (in degrees) to warp by relative to the specified RotationAxis"),CategoryName="Evaluation",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(12)=(PropertyName="LocomotionAngle",PropertyFriendlyName="Locomotion Angle",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_OrientationWarping:LocomotionAngle", "The character locomotion angle (in degrees) relative to the specified RotationAxis\nThis will be used in the following equation for computing the orientation angle: [Orientation = RotationBetween(RootMotionDirection, LocomotionDirection)]\nIn most cases, this is the difference between the Velocity of the Movement Component and the actor rotation (obtained via CalculateDirection)"),CategoryName="Evaluation",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(13)=(PropertyName="LocomotionDirection",PropertyFriendlyName="Locomotion Direction",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_OrientationWarping:LocomotionDirection", "The character movement direction vector in world space\nWhen set, this vector is used to compute LocomotionAngle automatically. When not set, the LocomotionAngle input should be used instead.\nIn most cases, this vector is the same as the Velocity vector of the Movement Component"),CategoryName="Evaluation",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(14)=(PropertyName="MinRootMotionSpeedThreshold",PropertyFriendlyName="Min Root Motion Speed Threshold",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_OrientationWarping:MinRootMotionSpeedThreshold", "Minimum root motion speed required to apply orientation warping\nThis is useful to prevent unnatural re-orientation when the animation has a portion with no root motion (i.e starts/stops/idles)\nWhen this value is greater than 0, it\'s recommended to enable interpolation with RotationInterpSpeed > 0"),CategoryName="Evaluation",bCanToggleVisibility=True)
         ShowPinForProperties(15)=(PropertyName="LocomotionAngleDeltaThreshold",PropertyFriendlyName="Locomotion Angle Delta Threshold",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_OrientationWarping:LocomotionAngleDeltaThreshold", "Specifies an angle threshold to prevent erroneous over-rotation of the character, disabled with a value of 0\n\nWhen the effective orientation warping angle is detected to be greater than this value (default: 90 degrees) the locomotion direction will be inverted prior to warping\nThis will be used in the following equation: [Orientation = RotationBetween(RootMotionDirection, -LocomotionDirection)]\n\nExample: Playing a forward running animation while the motion is going backward\nRather than orientation warping by 180 degrees, the system will warp by 0 degrees"),CategoryName="Evaluation",bCanToggleVisibility=True)
         ShowPinForProperties(16)=(PropertyName="SpineBones",PropertyFriendlyName="Spine Bones",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_OrientationWarping:SpineBones", "Spine bone definitions\nUsed to counter rotate the body in order to keep the character facing forward\nThe amount of counter rotation applied is driven by DistributedBoneOrientationAlpha"),CategoryName="Settings")
         ShowPinForProperties(17)=(PropertyName="IKFootRootBone",PropertyFriendlyName="IK Foot Root Bone",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_OrientationWarping:IKFootRootBone", "IK Foot Root Bone definition"),CategoryName="Settings")
         ShowPinForProperties(18)=(PropertyName="IKFootBones",PropertyFriendlyName="IK Foot Bones",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_OrientationWarping:IKFootBones", "IK Foot definitions"),CategoryName="Settings")
         ShowPinForProperties(19)=(PropertyName="CurrentAnimAsset",PropertyFriendlyName="Current Anim Asset",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_OrientationWarping:CurrentAnimAsset", "Experimental. Animation Asset for incorporating root motion data. If \'TargetTime\' is set, and the animation has root motion rotation within the TargetTime,\nthen those rotations will be scaled to reach the TargetOrientation"),CategoryName="Experimental",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(20)=(PropertyName="CurrentAnimAssetTime",PropertyFriendlyName="Current Anim Asset Time",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_OrientationWarping:CurrentAnimAssetTime", "Experimental. Current playback time in seconds of the CurrentAnimAsset"),CategoryName="Experimental",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(21)=(PropertyName="RotationAxis",PropertyFriendlyName="Rotation Axis",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_OrientationWarping:RotationAxis", "Rotation axis used when rotating the character body"),CategoryName="Settings")
         ShowPinForProperties(22)=(PropertyName="DistributedBoneOrientationAlpha",PropertyFriendlyName="Distributed Bone Orientation Alpha",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_OrientationWarping:DistributedBoneOrientationAlpha", "Specifies how much rotation is applied to the character body versus IK feet"),CategoryName="Settings",bCanToggleVisibility=True)
         ShowPinForProperties(23)=(PropertyName="RotationInterpSpeed",PropertyFriendlyName="Rotation Interp Speed",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_OrientationWarping:RotationInterpSpeed", "Specifies the interpolation speed (in Alpha per second) towards reaching the final warped rotation angle\nA value of 0 will cause instantaneous rotation, while a greater value will introduce smoothing"),CategoryName="Settings")
         ShowPinForProperties(24)=(PropertyName="CounterCompensateInterpSpeed",PropertyFriendlyName="Counter Compensate Interp Speed",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_OrientationWarping:CounterCompensateInterpSpeed", "Same as RotationInterpSpeed, but for CounterCompensate smoothing. A value of 0 sample raw root motion.\nUsed to avoid stuttering from resampling root deltas. Root motion is already smooth, so a large value is our default (~75% of 60 fps)."),CategoryName="Settings")
         ShowPinForProperties(25)=(PropertyName="MaxCorrectionDegrees",PropertyFriendlyName="Max Correction Degrees",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_OrientationWarping:MaxCorrectionDegrees", "Max correction we\'re allowed to do per-second when using interpolation.\nThis minimizes pops when we have a large difference between current and target orientation."),CategoryName="Settings")
         ShowPinForProperties(26)=(PropertyName="MaxRootMotionDeltaToCompensateDegrees",PropertyFriendlyName="Max Root Motion Delta to Compensate Degrees",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_OrientationWarping:MaxRootMotionDeltaToCompensateDegrees", "Don\'t compensate our interpolator when the instantaneous root motion delta is higher than this. This is likely a pivot."),CategoryName="Settings")
         ShowPinForProperties(27)=(PropertyName="bCounterCompenstateInterpolationByRootMotion",PropertyFriendlyName="Counter Compenstate Interpolation by Root Motion",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_OrientationWarping:bCounterCompenstateInterpolationByRootMotion", "Whether to counter compensate interpolation by the animated root motion angle change over time.\nThis helps to conserve the motion from our animation.\nDisable this if your root motion is expected to be jittery, and you want orientation warping to smooth it out."),CategoryName="Settings")
         ShowPinForProperties(28)=(PropertyName="bScaleByGlobalBlendWeight",PropertyFriendlyName="Scale by Global Blend Weight",CategoryName="Experimental",bCanToggleVisibility=True)
         ShowPinForProperties(29)=(PropertyName="bUseManualRootMotionVelocity",PropertyFriendlyName="Use Manual Root Motion Velocity",CategoryName="Experimental",bCanToggleVisibility=True)
         ShowPinForProperties(30)=(PropertyName="ManualRootMotionVelocity",PropertyFriendlyName="Manual Root Motion Velocity",CategoryName="Experimental",bCanToggleVisibility=True)
         ShowPinForProperties(31)=(PropertyName="WarpingSpace",PropertyFriendlyName="Warping Space",CategoryName="Evaluation",bCanToggleVisibility=True)
         ShowPinForProperties(32)=(PropertyName="WarpingSpaceTransform",PropertyFriendlyName="Warping Space Transform",CategoryName="Evaluation",bCanToggleVisibility=True)
         ShowPinForProperties(33)=(PropertyName="DebugDrawScale",PropertyFriendlyName="Debug Draw Scale",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_OrientationWarping:DebugDrawScale", "Scale all debug drawing visualization by a factor"),CategoryName="Debug")
         ShowPinForProperties(34)=(PropertyName="bEnableDebugDraw",PropertyFriendlyName="Enable Debug Draw",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_OrientationWarping:bEnableDebugDraw", "Enable/Disable orientation warping debug drawing"),CategoryName="Debug")
