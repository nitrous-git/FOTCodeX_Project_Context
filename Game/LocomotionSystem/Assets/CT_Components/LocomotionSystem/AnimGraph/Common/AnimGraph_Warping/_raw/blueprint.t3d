         Begin Object Name="AnimGraphNodeBinding_Base_0" ExportPath="/Script/AnimGraph.AnimGraphNodeBinding_Base'/Game/LocomotionSystem/Assets/CT_Components/LocomotionSystem/AnimGraph/Common/AnimGraph_Warping.AnimGraph_Warping:AnimGraph.AnimGraphNode_OrientationWarping_0.AnimGraphNodeBinding_Base_0'"
