         ShowPinForProperties(0)=(PropertyName="ComponentPose",PropertyFriendlyName="Component Pose",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_SkeletalControlBase:ComponentPose", "Input link"),CategoryName="Links",bShowPin=True)
         ShowPinForProperties(1)=(PropertyName="LODThreshold",PropertyFriendlyName="LOD Threshold",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_SkeletalControlBase:LODThreshold", "Max LOD that this node is allowed to run\nFor example if you have LODThreshold to be 2, it will run until LOD 2 (based on 0 index)\nwhen the component LOD becomes 3, it will stop update/evaluate\ncurrently transition would be issue and that has to be re-visited"),CategoryName="Performance",bCanToggleVisibility=True)
         ShowPinForProperties(2)=(PropertyName="AlphaInputType",PropertyFriendlyName="Alpha Input Type",CategoryName="Alpha")
         ShowPinForProperties(3)=(PropertyName="bAlphaBoolEnabled",PropertyFriendlyName="bEnabled",CategoryName="Alpha",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(4)=(PropertyName="Alpha",PropertyFriendlyName="Alpha",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_SkeletalControlBase:Alpha", "Current strength of the skeletal control"),CategoryName="Alpha",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(5)=(PropertyName="AlphaScaleBias",PropertyFriendlyName="Alpha Scale Bias",CategoryName="Alpha")
         ShowPinForProperties(6)=(PropertyName="AlphaBoolBlend",PropertyFriendlyName="Blend Settings",CategoryName="Alpha")
         ShowPinForProperties(7)=(PropertyName="AlphaCurveName",PropertyFriendlyName="Alpha Curve Name",CategoryName="Alpha",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(8)=(PropertyName="AlphaScaleBiasClamp",PropertyFriendlyName="Alpha Scale Bias Clamp",CategoryName="Alpha")
         ShowPinForProperties(9)=(PropertyName="Mode",PropertyFriendlyName="Mode",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_StrideWarping:Mode", "Stride warping evaluation mode (Graph or Manual)"),CategoryName="Evaluation")
         ShowPinForProperties(10)=(PropertyName="StrideDirection",PropertyFriendlyName="Stride Direction",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_StrideWarping:StrideDirection", "Component-space stride direction\nExample: A value of <1,0,0> will warp the leg stride along the Forward Vector"),CategoryName="Evaluation",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(11)=(PropertyName="StrideScale",PropertyFriendlyName="Stride Scale",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_StrideWarping:StrideScale", "Stride scale, specifying the amount of warping applied to the foot definitions\nExample: A value of 0.5 will decrease the effective leg stride by half, while a value of 2.0 will double it"),CategoryName="Evaluation",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(12)=(PropertyName="LocomotionSpeed",PropertyFriendlyName="Locomotion Speed",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_StrideWarping:LocomotionSpeed", "Locomotion speed, specifying the current speed of the character\nThis will be used in the following equation for computing the stride scale: [StrideScale = (LocomotionSpeed / RootMotionSpeed)]\nNote: This speed should be relative to the delta time of the animation graph\n\nStride scale is a value specifying the amount of warping applied to the IK foot definitions\nExample: A value of 0.5 will decrease the effective leg stride by half, while a value of 2.0 will double it"),CategoryName="Evaluation",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(13)=(PropertyName="MinRootMotionSpeedThreshold",PropertyFriendlyName="Min Root Motion Speed Threshold",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_StrideWarping:MinRootMotionSpeedThreshold", "Minimum root motion speed required to apply stride warping\nThis is useful to prevent unnatural strides when the animation has a portion with no root motion (i.e starts/stops)\nWhen this value is greater than 0, it\'s recommended to enable interpolation in StrideScaleModifier"),CategoryName="Evaluation",bCanToggleVisibility=True)
         ShowPinForProperties(14)=(PropertyName="PelvisBone",PropertyFriendlyName="Pelvis Bone",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_StrideWarping:PelvisBone", "Pevlis Bone definition"),CategoryName="Settings")
         ShowPinForProperties(15)=(PropertyName="IKFootRootBone",PropertyFriendlyName="IK Foot Root Bone",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_StrideWarping:IKFootRootBone", "IK Foot Root Bone definition"),CategoryName="Settings")
         ShowPinForProperties(16)=(PropertyName="FootDefinitions",PropertyFriendlyName="Foot Definitions",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_StrideWarping:FootDefinitions", "Foot definitions specifying the IK, FK, and Thigh bone"),CategoryName="Settings")
         ShowPinForProperties(17)=(PropertyName="StrideScaleModifier",PropertyFriendlyName="Stride Scale Modifier",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_StrideWarping:StrideScaleModifier", "Modifies the final stride scale value by optionally clamping and/or interpolating"),CategoryName="Settings",bCanToggleVisibility=True)
         ShowPinForProperties(18)=(PropertyName="FloorNormalDirection",PropertyFriendlyName="Floor Normal Direction",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_StrideWarping:FloorNormalDirection", "Floor normal direction, this value will internally convert into a corresponding Component-space representation prior to warping\nDefault: World Space, Up Vector: <0,0,1>"),CategoryName="Advanced",bCanToggleVisibility=True)
         ShowPinForProperties(19)=(PropertyName="GravityDirection",PropertyFriendlyName="Gravity Direction",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_StrideWarping:GravityDirection", "Gravity direction, this value will internally convert into a corresponding Component-space representation prior to warping\nDefault: World Space, Down Vector: <0,0,-1>"),CategoryName="Advanced",bCanToggleVisibility=True)
         ShowPinForProperties(20)=(PropertyName="PelvisIKFootSolver",PropertyFriendlyName="Pelvis IK Foot Solver",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_StrideWarping:PelvisIKFootSolver", "Solver for controlling how much the pelvis is \"pulled down\" towards the IK/FK foot definitions during leg limb extension"),CategoryName="Advanced")
         ShowPinForProperties(21)=(PropertyName="bOrientStrideDirectionUsingFloorNormal",PropertyFriendlyName="Orient Stride Direction Using Floor Normal",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_StrideWarping:bOrientStrideDirectionUsingFloorNormal", "Orients the specified (Manual) or computed (Graph) stride direction by the floor normal"),CategoryName="Advanced")
         ShowPinForProperties(22)=(PropertyName="bCompensateIKUsingFKThighRotation",PropertyFriendlyName="Compensate IK Using FK Thigh Rotation",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_StrideWarping:bCompensateIKUsingFKThighRotation", "Include warping adjustment to the FK thigh bones alongside the IK/FK foot definitions\nThis is used to help preserve the original overall leg shape"),CategoryName="Advanced")
         ShowPinForProperties(23)=(PropertyName="bClampIKUsingFKLimits",PropertyFriendlyName="Clamp IK Using FK Limits",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_StrideWarping:bClampIKUsingFKLimits", "Clamps the IK foot warping to prevent over-extension relative to the overall FK leg"),CategoryName="Advanced")
         ShowPinForProperties(24)=(PropertyName="bDisableIfMissingRootMotion",PropertyFriendlyName="Disable if Missing Root Motion",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_StrideWarping:bDisableIfMissingRootMotion", "Do not execute stride warping if animation data has no root motion"),CategoryName="Advanced")
         ShowPinForProperties(25)=(PropertyName="DebugDrawScale",PropertyFriendlyName="Debug Draw Scale",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_StrideWarping:DebugDrawScale", "Scale all debug drawing visualization by a factor"),CategoryName="Debug")
         ShowPinForProperties(26)=(PropertyName="bEnableDebugDraw",PropertyFriendlyName="Enable Debug Draw",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_StrideWarping:bEnableDebugDraw", "Enable/Disable stride warping debug drawing"),CategoryName="Debug")
         ShowPinForProperties(27)=(PropertyName="bDebugDrawIKFootOrigin",PropertyFriendlyName="Debug Draw IKFoot Origin",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_StrideWarping:bDebugDrawIKFootOrigin", "Enable/Disable IK foot location debug drawing prior to warping"),CategoryName="Debug")
         ShowPinForProperties(28)=(PropertyName="bDebugDrawIKFootAdjustment",PropertyFriendlyName="Debug Draw IKFoot Adjustment",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_StrideWarping:bDebugDrawIKFootAdjustment", "Enable/Disable IK foot location debug drawing following initial foot adjustment"),CategoryName="Debug")
         ShowPinForProperties(29)=(PropertyName="bDebugDrawPelvisAdjustment",PropertyFriendlyName="Debug Draw Pelvis Adjustment",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_StrideWarping:bDebugDrawPelvisAdjustment", "Enable/Disable pelvis debug drawing following adjustment"),CategoryName="Debug")
         ShowPinForProperties(30)=(PropertyName="bDebugDrawThighAdjustment",PropertyFriendlyName="Debug Draw Thigh Adjustment",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_StrideWarping:bDebugDrawThighAdjustment", "Enable/Disable thigh debug drawing following adjustment"),CategoryName="Debug")
         ShowPinForProperties(31)=(PropertyName="bDebugDrawIKFootFinal",PropertyFriendlyName="Debug Draw IKFoot Final",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_StrideWarping:bDebugDrawIKFootFinal", "Enable/Disable IK foot location debug drawing following all adsjustments (Final warped result)"),CategoryName="Debug")
