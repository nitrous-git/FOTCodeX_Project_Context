                                 ShowPinForProperties(11)=(PropertyName="bTeleportToExplicitTime",PropertyFriendlyName="Teleport to Explicit Time",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_SequenceEvaluator:bTeleportToExplicitTime", "If true, teleport to explicit time, does NOT advance time (does not trigger notifies, does not extract Root Motion, etc.)\n      If false, will advance time (will trigger notifies, extract root motion if applicable, etc.)\n      Note: using a sync group forces advancing time regardless of what this option is set to."),CategoryName="Settings",bCanToggleVisibility=True)
