                                 Begin Object Name="AnimGraphNodeBinding_Base_0" ExportPath="/Script/AnimGraph.AnimGraphNodeBinding_Base'/Game/LocomotionSystem/Assets/CT_Components/LocomotionSystem/AnimGraph/UE4/ABP_Locomotion_UE4.ABP_Locomotion_UE4:AnimGraph.AnimGraphNode_StateMachine_1.LocomotionSM.AnimStateNode_11.Pivot.AnimGraphNode_StateMachine_0.PivotSM.AnimStateNode_0.PivotA.AnimGraphNode_OrientationWarping_0.AnimGraphNodeBinding_Base_0'"
