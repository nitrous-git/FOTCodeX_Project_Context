      Begin Object Name="EdGraphNode_Comment_0" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/LocomotionSystem/Assets/CT_Components/LocomotionSystem/AnimGraph/UE4/ABP_Locomotion_UE4.ABP_Locomotion_UE4:SetRootYawOffset.EdGraphNode_Comment_0'"
         CommentColor=(R=0.392157,G=0.392157,B=0.392157,A=1.000000)
         bCommentBubbleVisible_InDetailsPanel=False
         NodePosX=-975
         NodePosY=-143
         NodeWidth=2176
         NodeHeight=560
         bCommentBubblePinned=False
         bCommentBubbleVisible=False
         NodeComment="TurnInPlace #3\r\nWe clamp the offset because at large offsets the character has to aim too far backwards, which over twists the spine. The turn in place animations will usually keep up with the offset, but this clamp will cause the feet to slide if the user rotates the camera too quickly.\r\nIf desired, this clamp could be replaced by having aim animations that can go up to 180 degrees or by triggering turn in place animations more aggressively."
         NodeGuid=454403024AB6AE9582DB42AE060FBF4A
      End Object
