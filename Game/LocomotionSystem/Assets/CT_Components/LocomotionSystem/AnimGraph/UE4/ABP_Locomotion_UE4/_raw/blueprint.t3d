         ShowPinForProperties(12)=(PropertyName="StartPosition",PropertyFriendlyName="Start Position",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_BlendSpacePlayer:StartPosition", "The start position in [0, 1] to use when initializing. When looping, play will still jump back to the beginning when reaching the end."),CategoryName="Settings",bCanToggleVisibility=True)
