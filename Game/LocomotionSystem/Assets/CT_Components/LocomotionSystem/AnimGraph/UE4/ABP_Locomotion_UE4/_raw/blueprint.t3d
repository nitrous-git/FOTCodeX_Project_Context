         ShowPinForProperties(3)=(PropertyName="GroupRole",PropertyFriendlyName="Group Role",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_BlendSpacePlayer:GroupRole", "The role this node can assume within the group (ignored if GroupName is not set). Note\nthat this is the role of the output of this node, not of animations contained by it."),CategoryName="Sync")
         ShowPinForProperties(4)=(PropertyName="bOverridePositionWhenJoiningSyncGroupAsLeader",PropertyFriendlyName="Override Position when Joining Sync Group as Leader",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_BlendSpacePlayer:bOverridePositionWhenJoiningSyncGroupAsLeader", "When enabled, acting as the leader, and using marker-based sync, this asset player will not sync to the previous leader\'s sync position when joining a sync group and before becoming the leader but instead force everyone else to match its position."),CategoryName="Sync")
         ShowPinForProperties(5)=(PropertyName="Method",PropertyFriendlyName="Method",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_BlendSpacePlayer:Method", "How this node will synchronize with other animations. Note that this determines how the output\nof this node is used for synchronization, not of animations contained by it."),CategoryName="Sync")
         ShowPinForProperties(6)=(PropertyName="bIgnoreForRelevancyTest",PropertyFriendlyName="Ignore for Relevancy Test",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_BlendSpacePlayer:bIgnoreForRelevancyTest", "If true, \"Relevant anim\" nodes that look for the highest weighted animation in a state will ignore this node"),CategoryName="Relevancy",bCanToggleVisibility=True)
         ShowPinForProperties(7)=(PropertyName="X",PropertyFriendlyName="X",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_BlendSpacePlayer:X", "The X coordinate to sample in the blendspace"),CategoryName="Coordinates",bShowPin=True,bCanToggleVisibility=True)
