      Begin Object Name="EdGraphNode_Comment_5" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/LocomotionSystem/Assets/CT_Components/LocomotionSystem/AnimGraph/UE4/ABP_Locomotion_UE4.ABP_Locomotion_UE4:ProcessTurnYawForwardFacing.EdGraphNode_Comment_5'"
         bCommentBubbleVisible_InDetailsPanel=False
         NodePosX=-1328
         NodePosY=-240
         NodeWidth=2240
         NodeHeight=832
         bCommentBubblePinned=False
         bCommentBubbleVisible=False
         NodeComment="The \"TurnYawWeight\" curve is set to 1 in TurnInPlace animations, so its current value from GetCurveValue will be the current weight of the TurnInPlace animation. \r\nWe can use this to \"unweight\" the TurnInPlace animation to get the full RemainingTurnYaw curve value. "
         NodeGuid=2C5C8836452C018A6D297AADC17786CF
      End Object
      Begin Object Name="EdGraphNode_Comment_6" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/LocomotionSystem/Assets/CT_Components/LocomotionSystem/AnimGraph/UE4/ABP_Locomotion_UE4.ABP_Locomotion_UE4:ProcessTurnYawForwardFacing.EdGraphNode_Comment_6'"
         bCommentBubbleVisible_InDetailsPanel=False
         NodePosX=2160
         NodePosY=-48
         NodeWidth=720
         NodeHeight=336
         bCommentBubblePinned=False
         bCommentBubbleVisible=False
         NodeComment="Avoid applying the curve delta when the curve first becomes relevant. E.g. When a turn animation starts, the previous curve value will be 0 and the current value will be 90, but no actual rotation has happened yet."
         NodeGuid=58EE6E404B44705D3CB01CB98E42B6DF
      End Object
      Begin Object Name="EdGraphNode_Comment_7" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/LocomotionSystem/Assets/CT_Components/LocomotionSystem/AnimGraph/UE4/ABP_Locomotion_UE4.ABP_Locomotion_UE4:ProcessTurnYawForwardFacing.EdGraphNode_Comment_7'"
         bCommentBubbleVisible_InDetailsPanel=False
         NodePosX=3023
         NodePosY=22
         NodeWidth=992
         NodeHeight=400
         bCommentBubblePinned=False
         bCommentBubbleVisible=False
         NodeComment="Reduce the root yaw offset by the amount of rotation from the turn animation."
         NodeGuid=D9AFA42C49935E3077A3619F61741145
      End Object
      Begin Object Name="EdGraphNode_Comment_3" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/LocomotionSystem/Assets/CT_Components/LocomotionSystem/AnimGraph/UE4/ABP_Locomotion_UE4.ABP_Locomotion_UE4:ProcessTurnYawForwardFacing.EdGraphNode_Comment_3'"
         CommentColor=(R=0.392157,G=0.392157,B=0.392157,A=1.000000)
         bCommentBubbleVisible_InDetailsPanel=False
         NodePosX=-1324
         NodePosY=-578
         NodeWidth=1200
         NodeHeight=288
         bCommentBubblePinned=False
         bCommentBubbleVisible=False
         NodeComment="TurnInPlace #5\r\nWhen the yaw offset gets too big, we trigger TurnInPlace animations to rotate the character back. E.g. if the camera is rotated 90 degrees to the right, it will be facing the character\'s right shoulder. If we play an animation that rotates the character 90 degrees to the left, the character will once again be facing away from the camera.\r\nWe use the \"TurnYawAnimModifier\" animation modifier to generate the necessary curves on each TurnInPlace animation.\r\nSee ABP_ItemAnimLayersBase for examples of triggering TurnInPlace animations."
         NodeGuid=2D8752D842B04B4623FB48ADDB63A284
      End Object
