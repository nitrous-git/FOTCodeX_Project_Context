         ShowPinForProperties(7)=(PropertyName="bMeshSpaceRotationBlend",PropertyFriendlyName="Mesh Space Rotation Blend",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_LayeredBoneBlend:bMeshSpaceRotationBlend", "Whether to blend bone rotations in mesh space or in local space"),CategoryName="Config")
