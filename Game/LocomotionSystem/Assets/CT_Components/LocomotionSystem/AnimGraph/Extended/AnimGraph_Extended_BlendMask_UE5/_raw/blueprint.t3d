         ShowPinForProperties(9)=(PropertyName="bMeshSpaceScaleBlend",PropertyFriendlyName="Mesh Space Scale Blend",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_LayeredBoneBlend:bMeshSpaceScaleBlend", "Whether to blend bone scales in mesh space or in local space"),CategoryName="Config")
         ShowPinForProperties(10)=(PropertyName="CurveBlendOption",PropertyFriendlyName="Curve Blend Option",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_LayeredBoneBlend:CurveBlendOption", "How to blend the layers together"),CategoryName="Config")
