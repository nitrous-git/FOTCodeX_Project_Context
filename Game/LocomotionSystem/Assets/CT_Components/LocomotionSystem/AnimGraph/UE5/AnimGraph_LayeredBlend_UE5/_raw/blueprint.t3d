         ShowPinForProperties(0)=(PropertyName="BasePose",PropertyFriendlyName="Base Pose",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_LayeredBoneBlend:BasePose", "The source pose"),CategoryName="Links",bCanToggleVisibility=True)
         ShowPinForProperties(1)=(PropertyName="BlendPoses",PropertyFriendlyName="Blend Poses",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_LayeredBoneBlend:BlendPoses", "Each layer\'s blended pose"),CategoryName="Links",bCanToggleVisibility=True)
         ShowPinForProperties(2)=(PropertyName="BlendMode",PropertyFriendlyName="Blend Mode",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_LayeredBoneBlend:BlendMode", "Whether to use branch filters or a blend mask to specify an input pose per-bone influence"),CategoryName="Config",bCanToggleVisibility=True)
         ShowPinForProperties(3)=(PropertyName="BlendMasks",PropertyFriendlyName="Blend Masks",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_LayeredBoneBlend:BlendMasks", "The blend masks to use for our layer inputs. Allows the use of per-bone alphas.\nBlend masks are used when BlendMode is BlendMask."),CategoryName="Config",bCanToggleVisibility=True)
         ShowPinForProperties(4)=(PropertyName="LayerSetup",PropertyFriendlyName="Layer Setup",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_LayeredBoneBlend:LayerSetup", "Configuration for the parts of the skeleton to blend for each layer. Allows\ncertain parts of the tree to be blended out or omitted from the pose.\nLayerSetup is used when BlendMode is BranchFilter."),CategoryName="Config",bCanToggleVisibility=True)
         ShowPinForProperties(5)=(PropertyName="BlendWeights",PropertyFriendlyName="Blend Weights",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_LayeredBoneBlend:BlendWeights", "The weights of each layer"),CategoryName="Runtime",bCanToggleVisibility=True)
         ShowPinForProperties(6)=(PropertyName="LODThreshold",PropertyFriendlyName="LOD Threshold",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_LayeredBoneBlend:LODThreshold", "Max LOD that this node is allowed to run\nFor example if you have LODThreshold to be 2, it will run until LOD 2 (based on 0 index)\nwhen the component LOD becomes 3, it will stop update/evaluate\ncurrently transition would be issue and that has to be re-visited"),CategoryName="Performance",bCanToggleVisibility=True)
         ShowPinForProperties(7)=(PropertyName="bMeshSpaceRotationBlend",PropertyFriendlyName="Mesh Space Rotation Blend",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_LayeredBoneBlend:bMeshSpaceRotationBlend", "Whether to blend bone rotations in mesh space or in local space"),CategoryName="Config",bCanToggleVisibility=True)
         ShowPinForProperties(8)=(PropertyName="bRootSpaceRotationBlend",PropertyFriendlyName="Root Space Rotation Blend",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_LayeredBoneBlend:bRootSpaceRotationBlend", "Whether to blend bone rotations in root space or in mesh space"),CategoryName="Config",bCanToggleVisibility=True,bHasOverridePin=True)
