                        Begin Object Name="EdGraphNode_Comment_0" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/LocomotionSystem/Assets/CT_Components/LocomotionSystem/AnimGraph/UE5/ABP_Locomotion_UE5.ABP_Locomotion_UE5:AnimGraph.AnimGraphNode_StateMachine_1.LocomotionSM.AnimStateNode_1.Idle.AnimGraphNode_StateMachine_0.IdleSM.EdGraphNode_Comment_0'"
                           CommentColor=(R=0.392157,G=0.392157,B=0.392157,A=1.000000)
                           bCommentBubbleVisible_InDetailsPanel=False
                           NodePosX=480
                           NodePosY=-496
                           NodeWidth=1072
                           NodeHeight=848
                           bCommentBubblePinned=False
                           bCommentBubbleVisible=False
                           NodeComment="TurnInPlace #6 (also see AnimBP_Mannequin_Base)\r\nWhen the yaw offset gets big enough, we trigger a TurnInPlace animation to reduce the offset.\r\nTurnInPlace animations often end with some settling motion when the rotation is finished. During this time, we move to the TurnInPlaceRecovery state, which can transition back to the TurnInPlaceRotation state if the offset gets big again.\r\nThis way we can keep playing the rotation part of the TurnInPlace animations if the Pawn owner keeps rotating, without waiting for the settle to finish."
                           NodeGuid=68F433BC41B40EFBB9E308B6C44E189E
                        End Object
