      End Object
      Begin Object Name="EdGraphNode_Comment_6" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/LocomotionSystem/Assets/CT_Components/LocomotionSystem/AnimGraph/UE5/ABP_Locomotion_UE5.ABP_Locomotion_UE5:ProcessTurnYawForwardFacing.EdGraphNode_Comment_6'"
         bCommentBubbleVisible_InDetailsPanel=False
         NodePosX=2160
         NodePosY=-48
         NodeWidth=720
         NodeHeight=336
         bCommentBubblePinned=False
         bCommentBubbleVisible=False
         NodeComment="Avoid applying the curve delta when the curve first becomes relevant. E.g. When a turn animation starts, the previous curve value will be 0 and the current value will be 90, but no actual rotation has happened yet."
         NodeGuid=078185BF413ABC838FEA1E8D17B95A94
      End Object
      Begin Object Name="EdGraphNode_Comment_5" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/LocomotionSystem/Assets/CT_Components/LocomotionSystem/AnimGraph/UE5/ABP_Locomotion_UE5.ABP_Locomotion_UE5:ProcessTurnYawForwardFacing.EdGraphNode_Comment_5'"
         bCommentBubbleVisible_InDetailsPanel=False
         NodePosX=-1328
         NodePosY=-240
         NodeWidth=2240
         NodeHeight=832
         bCommentBubblePinned=False
         bCommentBubbleVisible=False
         NodeComment="The \"TurnYawWeight\" curve is set to 1 in TurnInPlace animations, so its current value from GetCurveValue will be the current weight of the TurnInPlace animation. \r\nWe can use this to \"unweight\" the TurnInPlace animation to get the full RemainingTurnYaw curve value. "
         NodeGuid=AA1E1CC24EA0CE7539DCF6A6D4500832
      End Object
