      Begin Object Name="EdGraphNode_Comment_3" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/LocomotionSystem/Assets/CT_Components/LocomotionSystem/AnimGraph/UE5/ABP_Locomotion_UE5.ABP_Locomotion_UE5:ProcessTurnYawCurve.EdGraphNode_Comment_3'"
         CommentColor=(R=0.392157,G=0.392157,B=0.392157,A=1.000000)
         bCommentBubbleVisible_InDetailsPanel=False
         NodePosX=-396
         NodePosY=-578
         NodeWidth=1200
         NodeHeight=288
         bCommentBubblePinned=False
         bCommentBubbleVisible=False
         NodeComment="TurnInPlace #5\r\nWhen the yaw offset gets too big, we trigger TurnInPlace animations to rotate the character back. E.g. if the camera is rotated 90 degrees to the right, it will be facing the character\'s right shoulder. If we play an animation that rotates the character 90 degrees to the left, the character will once again be facing away from the camera.\r\nWe use the \"TurnYawAnimModifier\" animation modifier to generate the necessary curves on each TurnInPlace animation.\r\nSee ABP_ItemAnimLayersBase for examples of triggering TurnInPlace animations."
         NodeGuid=948F408D46CD4E625B8AAEBC07915AB2
      End Object
      Begin Object Name="EdGraphNode_Comment_7" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/LocomotionSystem/Assets/CT_Components/LocomotionSystem/AnimGraph/UE5/ABP_Locomotion_UE5.ABP_Locomotion_UE5:ProcessTurnYawCurve.EdGraphNode_Comment_7'"
         bCommentBubbleVisible_InDetailsPanel=False
         NodePosX=3023
         NodePosY=22
         NodeWidth=992
         NodeHeight=400
         bCommentBubblePinned=False
         bCommentBubbleVisible=False
         NodeComment="Reduce the root yaw offset by the amount of rotation from the turn animation."
         NodeGuid=7E268A1F4FF9311016B5C6BEA03D532B
      End Object
      Begin Object Name="EdGraphNode_Comment_6" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/LocomotionSystem/Assets/CT_Components/LocomotionSystem/AnimGraph/UE5/ABP_Locomotion_UE5.ABP_Locomotion_UE5:ProcessTurnYawCurve.EdGraphNode_Comment_6'"
         bCommentBubbleVisible_InDetailsPanel=False
         NodePosX=2160
         NodePosY=-48
         NodeWidth=720
         NodeHeight=336
         bCommentBubblePinned=False
         bCommentBubbleVisible=False
         NodeComment="Avoid applying the curve delta when the curve first becomes relevant. E.g. When a turn animation starts, the previous curve value will be 0 and the current value will be 90, but no actual rotation has happened yet."
         NodeGuid=9C0316F84E6E8DC285AAC88F439F3CE9
      End Object
      Begin Object Name="EdGraphNode_Comment_5" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/LocomotionSystem/Assets/CT_Components/LocomotionSystem/AnimGraph/UE5/ABP_Locomotion_UE5.ABP_Locomotion_UE5:ProcessTurnYawCurve.EdGraphNode_Comment_5'"
         bCommentBubbleVisible_InDetailsPanel=False
         NodePosX=-400
         NodePosY=-240
         NodeWidth=2240
         NodeHeight=832
         bCommentBubblePinned=False
         bCommentBubbleVisible=False
         NodeComment="The \"TurnYawWeight\" curve is set to 1 in TurnInPlace animations, so its current value from GetCurveValue will be the current weight of the TurnInPlace animation. \r\nWe can use this to \"unweight\" the TurnInPlace animation to get the full RemainingTurnYaw curve value. "
         NodeGuid=3ADDAA9443D6FB91666D87B949D4C9A7
      End Object
