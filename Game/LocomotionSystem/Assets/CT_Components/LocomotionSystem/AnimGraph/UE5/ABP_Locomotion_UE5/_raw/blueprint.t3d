      Begin Object Name="EdGraphNode_Comment_3" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/LocomotionSystem/Assets/CT_Components/LocomotionSystem/AnimGraph/UE5/ABP_Locomotion_UE5.ABP_Locomotion_UE5:ProcessTurnYawForwardFacing.EdGraphNode_Comment_3'"
         CommentColor=(R=0.392157,G=0.392157,B=0.392157,A=1.000000)
         bCommentBubbleVisible_InDetailsPanel=False
         NodePosX=-1324
         NodePosY=-578
         NodeWidth=1200
         NodeHeight=288
         bCommentBubblePinned=False
         bCommentBubbleVisible=False
         NodeComment="TurnInPlace #5\r\nWhen the yaw offset gets too big, we trigger TurnInPlace animations to rotate the character back. E.g. if the camera is rotated 90 degrees to the right, it will be facing the character\'s right shoulder. If we play an animation that rotates the character 90 degrees to the left, the character will once again be facing away from the camera.\r\nWe use the \"TurnYawAnimModifier\" animation modifier to generate the necessary curves on each TurnInPlace animation.\r\nSee ABP_ItemAnimLayersBase for examples of triggering TurnInPlace animations."
         NodeGuid=4EB62AFB4A681C5E729CAB9F4F298D42
      End Object
