      Begin Object Name="EdGraphNode_Comment_1" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/LocomotionSystem/Assets/CT_Components/LocomotionSystem/AnimGraph/UE5/ABP_Locomotion_UE5.ABP_Locomotion_UE5:UpdateStartAnim_Layer.EdGraphNode_Comment_1'"
         CommentColor=(R=0.180392,G=0.180392,B=0.180392,A=1.000000)
         bCommentBubbleVisible_InDetailsPanel=False
         NodePosX=-160
         NodePosY=-320
         NodeWidth=1152
         NodeHeight=512
         bCommentBubblePinned=False
         bCommentBubbleVisible=False
         NodeComment="AnimBP Tour #9\r\nThis is an example of using Distance Matching to ensure that the distance traveled by the Start animation matches the distance traveled by the Pawn owner. This prevents foot sliding by keeping the animation and the motion model in sync.\r\nThis effectively controls the play rate of the Start animation. We clamp the effective play rate to prevent the animation from playing too slowly or too quickly.\r\nIf the effective play rate is clamped, we will still see some sliding. To fix this, we use Stride Warping later to adjust the pose to correct for the remaining difference.\r\nThe Animation Locomotion Library plugin is required to have access to Distance Matching functions."
         NodeGuid=4F010F36416FF707AF5212BEC612F664
      End Object
