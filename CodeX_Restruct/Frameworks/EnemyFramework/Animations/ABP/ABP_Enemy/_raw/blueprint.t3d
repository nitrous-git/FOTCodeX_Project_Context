         ShowPinForProperties(0)=(PropertyName="MaxTransitionsPerFrame",PropertyFriendlyName="Max Transitions Per Frame",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_StateMachine:MaxTransitionsPerFrame", "The maximum number of transitions that can be taken by this machine \'simultaneously\' in a single frame"),CategoryName="Settings")
         ShowPinForProperties(1)=(PropertyName="MaxTransitionsRequests",PropertyFriendlyName="Max Transitions Requests",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_StateMachine:MaxTransitionsRequests", "The maximum number of transition requests that can be buffered at any time.\nThe oldest transition requests are dropped to accommodate for newly created requests."),CategoryName="Settings")
         ShowPinForProperties(2)=(PropertyName="bSkipFirstUpdateTransition",PropertyFriendlyName="Skip First Update Transition",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_StateMachine:bSkipFirstUpdateTransition", "When the state machine becomes relevant, it is initialized into the Entry state.\nIt then tries to take any valid transitions to possibly end up in a different state on that same frame.\n- if true, that new state starts full weight.\n- if false, a blend is created between the entry state and that new state.\nIn either case all visited State notifications (Begin/End) will be triggered."),CategoryName="Settings")
         ShowPinForProperties(3)=(PropertyName="bReinitializeOnBecomingRelevant",PropertyFriendlyName="Reinitialize on Becoming Relevant",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_StateMachine:bReinitializeOnBecomingRelevant", "Reinitialize the state machine if we have become relevant to the graph\nafter not being ticked on the previous frame(s)"),CategoryName="Settings")
         ShowPinForProperties(4)=(PropertyName="bCreateNotifyMetaData",PropertyFriendlyName="Create Notify Meta Data",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_StateMachine:bCreateNotifyMetaData", "Tag Notifies with meta data such as the active state and mirroring state.  Producing this\ndata has a  slight performance cost."),CategoryName="Settings")
         ShowPinForProperties(5)=(PropertyName="bAllowConduitEntryStates",PropertyFriendlyName="Allow Conduit Entry States",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_StateMachine:bAllowConduitEntryStates", "Allows a conduit to be used as this state machine\'s entry state\nIf a valid entry state cannot be found at runtime then this will generate a reference pose!"),CategoryName="Settings")
