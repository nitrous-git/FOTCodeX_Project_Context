   NewVariables(1)=(VarName="AnimationType",VarGuid=5422525C4CC3B2FFD23F2A8D14D5F219,VarType=(PinCategory="byte",PinSubCategoryObject="/Script/Engine.UserDefinedEnum'/Game/CodeX_Restruct/Frameworks/TraversalDeviceFramework/Core/Enums/AnimationType_Enum.AnimationType_Enum'"),FriendlyName="Animation Type",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Animation that plays while using the spring. Select No Animation if you want to play some custom animations.")))
   NewVariables(2)=(VarName="SpringLocation",VarGuid=88900405477148C3AB47818312C78FCF,VarType=(PinCategory="struct",PinSubCategoryObject="/Script/CoreUObject.ScriptStruct'/Script/CoreUObject.Vector'"),FriendlyName="Spring Location",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="You can select and drag the 3D Widget in the current level viewport to move the spring around the level."),(DataKey="MakeEditWidget",DataValue="true")))
   NewVariables(3)=(VarName="SpringBoxExtend",VarGuid=230DE4DD4F070AC64F908F96DDB48932,VarType=(PinCategory="struct",PinSubCategoryObject="/Script/CoreUObject.ScriptStruct'/Script/CoreUObject.Vector'"),FriendlyName="Spring Box Extend",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Here we can modify the scale of the box collision used by the spring.")))
   NewVariables(4)=(VarName="TargetActorReference",VarGuid=A211DA4C462A2B9C27C620930D1939FD,VarType=(PinCategory="object",PinSubCategoryObject="/Script/CoreUObject.Class'/Script/Engine.Actor'"),FriendlyName="Target Actor Reference",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=2053,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Here we can add an Actor reference from the level. The end location of the predicted launch path will be placed at the same location of the Actor reference. Please keep in mind that, by default, the world location of this Spring Actor (not the referenced Actor) will be used to determine the predicted launch path destination. This can be useful when trying to create connections or chains between Actors.")))
   NewVariables(5)=(VarName="SnapTargetLocationToFloor?",VarGuid=B05941A442AB910E2EE7E0A8C9A5EFF6,VarType=(PinCategory="bool"),FriendlyName="Snap Target Location to Floor?",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Setting this True will snap the predicted launch path end location to the floor.")))
   NewVariables(6)=(VarName="Trace Channel For Floor",VarGuid=6558F5934A44FEE478A2ABA75CF0D40B,VarType=(PinCategory="byte",PinSubCategoryObject="/Script/CoreUObject.Enum'/Script/Engine.ETraceTypeQuery'"),FriendlyName="Trace Channel for Floor",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Trace Channel used to hit and get the floor location.")))
   NewVariables(7)=(VarName="PredictedPathVisible?",VarGuid=ACB5345C4D1F2750978B088048C43B63,VarType=(PinCategory="bool"),FriendlyName="Predicted Path Visible?",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Here we can toggle the visibility of the predicted launch path.")))
   NewVariables(8)=(VarName="PredictedPathHidden?",VarGuid=C21F90E2494E2277E8EC139581F908F5,VarType=(PinCategory="bool"),FriendlyName="Predicted Path Hidden?",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Setting this True will hide (in game) the predicted launch path.")))
   NewVariables(9)=(VarName="Arc Height",VarGuid=2BE296A14A881838BCB58E84A7EC289D,VarType=(PinCategory="real",PinSubCategory="double",bSerializeAsSinglePrecisionFloat=True),FriendlyName="Arc Height",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="UIMin",DataValue="0.05"),(DataKey="UIMax",DataValue="0.95"),(DataKey="tooltip",DataValue="Here we can modify the height of the predicted launch path.")))
   NewVariables(10)=(VarName="Simulation Time",VarGuid=D4618F57407A66C834FEB3BFACB8CCFD,VarType=(PinCategory="real",PinSubCategory="double",bSerializeAsSinglePrecisionFloat=True),FriendlyName="Simulation Time",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Increasing this value will prolong the simulation used to predict the launch path. It can be increased if the predicted path stops simulating, for example when the spring is placed far from the destination or the height of the arc travels a great distance (and stops simulating).")))
   NewVariables(11)=(VarName="Simulation Frequency",VarGuid=DC106B0E4E8AFE2F9B69FF9BBFC8A947,VarType=(PinCategory="real",PinSubCategory="double",bSerializeAsSinglePrecisionFloat=True),FriendlyName="Simulation Frequency",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Increasing this value will increase the number of steps (trace points) used during the simulation. You will notice the predicted path instance meshes getting closer.")))
   NewVariables(12)=(VarName="MovementInputBehavior",VarGuid=B9D1412A4CFA786A7E5D4EB39BA8F4FF,VarType=(PinCategory="byte",PinSubCategoryObject="/Script/Engine.UserDefinedEnum'/Game/CodeX_Restruct/Frameworks/TraversalDeviceFramework/Core/Enums/InputBehavior_Enum.InputBehavior_Enum'"),FriendlyName="Movement Input Behavior",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Select if you would like to ignore or not the movement input while launching the character. Ignoring it will restore it after landing.")))
   NewVariables(13)=(VarName="CharacterLaunchPosition",VarGuid=6D726BB34CA9DAD4ACC4F7A5463267CB,VarType=(PinCategory="byte",PinSubCategoryObject="/Script/Engine.UserDefinedEnum'/Game/CodeX_Restruct/Frameworks/TraversalDeviceFramework/Core/Enums/LaunchLocation_Enum.LaunchLocation_Enum'"),FriendlyName="Character Launch Position",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Selecting Closest Point From Spline will move the character to the spline\'s closest point before launching, so instead of moving them to the center of the box collision, we chose the closest middle point. // Selecting Character Overlap Location will not move the character and just launch them form the location of the initial overlap (current location). // Selecting Box Collision World Location will move the character to the center of the box collision before launching them. Useful when trying to follow perfectly the predicted launch path (from the center of the box collision).")))
   NewVariables(14)=(VarName="DestinationMeshHidden?",VarGuid=96803AF84814ADB90BC515987C807620,VarType=(PinCategory="bool"),FriendlyName="Destination Mesh Hidden?",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Set this True to hide in game the destination mesh (at the end of the predicted launch path).")))
   NewVariables(15)=(VarName="DestinationMeshType",VarGuid=A120E3784DD1F495E15137BCDFBC86AE,VarType=(PinCategory="byte",PinSubCategoryObject="/Script/Engine.UserDefinedEnum'/Game/CodeX_Restruct/Frameworks/TraversalDeviceFramework/Core/Enums/EndLocation_Enum.EndLocation_Enum'"),FriendlyName="Destination Mesh Type",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Select the mesh used at the end of the predicted launch path.")))
   NewVariables(16)=(VarName="ActorsToIgnore (TracePath)",VarGuid=4D64EC4842D095C40A9CE69D00004444,VarType=(PinCategory="object",PinSubCategoryObject="/Script/CoreUObject.Class'/Script/Engine.Actor'",ContainerType=Array),FriendlyName="Actors to Ignore (Trace Path)",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=2053,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="We can add Actors from the level that the trace (launch path) will ignore.")))
   NewVariables(17)=(VarName="Actors To Ignore (Overlap)",VarGuid=470A164C47C3D693AF5AEFAE43CDAC05,VarType=(PinCategory="object",PinSubCategoryObject="/Script/CoreUObject.Class'/Script/Engine.Actor'",ContainerType=Array),FriendlyName="Actors to Ignore (Overlap)",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=2053,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Here we can add Actors that the overlap will ignore during the construction script. Only add if necessary. By default, no other Actor should overlap this one.")))
