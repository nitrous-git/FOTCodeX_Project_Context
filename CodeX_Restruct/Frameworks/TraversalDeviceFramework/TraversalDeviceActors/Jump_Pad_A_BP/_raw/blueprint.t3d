   NewVariables(1)=(VarName="AnimationType",VarGuid=A853AFA147CABBE2C920D582125DE5FF,VarType=(PinCategory="byte",PinSubCategoryObject="/Script/Engine.UserDefinedEnum'/Game/CodeX_Restruct/Frameworks/TraversalDeviceFramework/Core/Enums/JumpPadAnimationType_Enum.JumpPadAnimationType_Enum'"),FriendlyName="Animation Type",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Animation that plays while using the jump pad. Select No Animation if you want to play some custom animations.")))
   NewVariables(2)=(VarName="LaunchLocation",VarGuid=6638E7364666BC625EF21296C3902CF4,VarType=(PinCategory="struct",PinSubCategoryObject="/Script/CoreUObject.ScriptStruct'/Script/CoreUObject.Vector'"),FriendlyName="Launch Location",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="MakeEditWidget",DataValue="true"),(DataKey="tooltip",DataValue="You can select and drag the 3D Widget in the current level viewport to move the jump pad around the level.")))
   NewVariables(3)=(VarName="JumpPadBoxExtend",VarGuid=81A4045C4951BB2D89A45DA0A19A3BB8,VarType=(PinCategory="struct",PinSubCategoryObject="/Script/CoreUObject.ScriptStruct'/Script/CoreUObject.Vector'"),FriendlyName="Jump Pad Box Extend",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Here we can modify the scale of the box collision used by the jump pad.")))
   NewVariables(4)=(VarName="Jump Pad Rotation Y (Pitch)",VarGuid=2F1B0A974FA6041B340620832CB58CC7,VarType=(PinCategory="real",PinSubCategory="double",bSerializeAsSinglePrecisionFloat=True),FriendlyName="Jump Pad Rotation Y (Pitch)",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="The pitch value used to rotate both the jump pad mesh and the box collision, using the launch location as the pivot point.")))
   NewVariables(5)=(VarName="TargetActorReference",VarGuid=45AFBC744B96D0C5F7CE1492148E818B,VarType=(PinCategory="object",PinSubCategoryObject="/Script/CoreUObject.Class'/Script/Engine.Actor'"),FriendlyName="Target Actor Reference",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=2053,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Here we can add an Actor reference from the level. The end location of the predicted launch path will be placed at the same location of the Actor reference. Please keep in mind that, by default, the world location of this Jump Pad Actor (not the referenced Actor) will be used to determine the predicted launch path destination. This can be useful when trying to create connections or chains between Actors.")))
   NewVariables(6)=(VarName="SnapTargetLocationToFloor?",VarGuid=D297FD584846793DD48BDFAB53A57C77,VarType=(PinCategory="bool"),FriendlyName="Snap Target Location to Floor?",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Setting this True will snap the predicted launch path end location to the floor.")))
   NewVariables(7)=(VarName="Trace Channel For Floor",VarGuid=697B2E1D46998C962822E08FC03A97F1,VarType=(PinCategory="byte",PinSubCategoryObject="/Script/CoreUObject.Enum'/Script/Engine.ETraceTypeQuery'"),FriendlyName="Trace Channel for Floor",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Trace Channel used to hit and get the floor location.")))
   NewVariables(8)=(VarName="PredictedPathVisible?",VarGuid=8D331DF64D18B81F93B6D9B054FCE0D6,VarType=(PinCategory="bool"),FriendlyName="Predicted Path Visible?",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Here we can toggle the visibility of the predicted launch path.")))
   NewVariables(9)=(VarName="PredictedPathHidden?",VarGuid=AF1E7F7E4295E1B02A61289F40E2F6CA,VarType=(PinCategory="bool"),FriendlyName="Predicted Path Hidden?",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Setting this True will hide (in game) the predicted launch path.")))
   NewVariables(10)=(VarName="Arc Height",VarGuid=783BA81247E4DA71AA18A8AC6212881A,VarType=(PinCategory="real",PinSubCategory="double",bSerializeAsSinglePrecisionFloat=True),FriendlyName="Arc Height",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="UIMin",DataValue="0.05"),(DataKey="UIMax",DataValue="0.95"),(DataKey="tooltip",DataValue="Here we can modify the height of the predicted launch path.")))
   NewVariables(11)=(VarName="Simulation Time",VarGuid=654D9BCE45B5F876E21663A023CAB3C9,VarType=(PinCategory="real",PinSubCategory="double",bSerializeAsSinglePrecisionFloat=True),FriendlyName="Simulation Time",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Increasing this value will prolong the simulation used to predict the launch path. It can be increased if the predicted path stops simulating, for example when the jump pad is placed far from the destination or the height of the arc travels a great distance (and stops simulating).")))
   NewVariables(12)=(VarName="Simulation Frequency",VarGuid=855FC0564C2F2F0E7DF21C895CAA93E6,VarType=(PinCategory="real",PinSubCategory="double",bSerializeAsSinglePrecisionFloat=True),FriendlyName="Simulation Frequency",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Increasing this value will increase the number of steps (trace points) used during the simulation. You will notice the predicted path instance meshes getting closer.")))
   NewVariables(13)=(VarName="Use Spline Midpoint?",VarGuid=DDCA84B548BBEEE2074465B33AC492A9,VarType=(PinCategory="bool"),FriendlyName="Use Spline Midpoint?",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Setting this True will move the Character to the Launch Location (spline midpoint) before launching. If False, the Character will keep its position and move to the closest point at the end of the ramp before launching.")))
   NewVariables(14)=(VarName="MovementInputBehavior",VarGuid=5E0DB7F544B8B2D2A45684A10BCEF8ED,VarType=(PinCategory="byte",PinSubCategoryObject="/Script/Engine.UserDefinedEnum'/Game/CodeX_Restruct/Frameworks/TraversalDeviceFramework/Core/Enums/InputBehavior_Enum.InputBehavior_Enum'"),FriendlyName="Movement Input Behavior",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Select if you would like to ignore or not the movement input while launching the character. Ignoring it will restore it after landing.")))
   NewVariables(15)=(VarName="DestinationMeshHidden?",VarGuid=64715BB64527868553E4FA9A4A72B071,VarType=(PinCategory="bool"),FriendlyName="Destination Mesh Hidden?",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Set this True to hide in game the destination mesh (at the end of the predicted launch path).")))
