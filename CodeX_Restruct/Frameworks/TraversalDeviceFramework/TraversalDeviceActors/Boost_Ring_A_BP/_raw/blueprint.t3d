   NewVariables(2)=(VarName="RingLocation",VarGuid=F287813B493A4F7F5A5E49BCD90920AE,VarType=(PinCategory="struct",PinSubCategoryObject="/Script/CoreUObject.ScriptStruct'/Script/CoreUObject.Vector'"),FriendlyName="Ring Location",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="MakeEditWidget",DataValue="true"),(DataKey="tooltip",DataValue="You can select and drag the 3D Widget in the current level viewport to move the boost ring around the level.")))
   NewVariables(3)=(VarName="RingBoxExtend",VarGuid=D9FB6AD949967A1DBD9F958981932646,VarType=(PinCategory="struct",PinSubCategoryObject="/Script/CoreUObject.ScriptStruct'/Script/CoreUObject.Vector'"),FriendlyName="Ring Box Extend",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Here we can modify the scale of the box collision used by the ring.")))
   NewVariables(4)=(VarName="TargetActorReference",VarGuid=8858DD6E4AE81D6E90936DBCF5AD8344,VarType=(PinCategory="object",PinSubCategoryObject="/Script/CoreUObject.Class'/Script/Engine.Actor'"),FriendlyName="Target Actor Reference",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=2053,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Here we can add an Actor reference from the level. The end location of the predicted launch path will be placed at the same location of the Actor reference. Please keep in mind that, by default, the world location of this Boost Ring Actor (not the referenced Actor) will be used to determine the predicted launch path destination. This can be useful when trying to create connections or chains between Actors.")))
   NewVariables(5)=(VarName="SnapTargetLocationToFloor?",VarGuid=E51943DB4E1F4B83173CC0B9F2BE03B8,VarType=(PinCategory="bool"),FriendlyName="Snap Target Location to Floor?",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Setting this True will snap the predicted launch path end location to the floor.")))
   NewVariables(6)=(VarName="Trace Channel For Floor",VarGuid=0FEB491545EE5629D73A2284D5E7CC54,VarType=(PinCategory="byte",PinSubCategoryObject="/Script/CoreUObject.Enum'/Script/Engine.ETraceTypeQuery'"),FriendlyName="Trace Channel for Floor",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Trace Channel used to hit and get the floor location.")))
   NewVariables(7)=(VarName="PredictedPathVisible?",VarGuid=AA6D18214826CF685C402EA9EB0AAFC0,VarType=(PinCategory="bool"),FriendlyName="Predicted Path Visible?",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Here we can toggle the visibility of the predicted launch path.")))
   NewVariables(8)=(VarName="PredictedPathHidden?",VarGuid=C1B86C5947447B3DA39538ACE6DF961C,VarType=(PinCategory="bool"),FriendlyName="Predicted Path Hidden?",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Setting this True will hide (in game) the predicted launch path.")))
   NewVariables(9)=(VarName="Arc Height",VarGuid=3F43696049042AF2486145B3E9F44834,VarType=(PinCategory="real",PinSubCategory="double",bSerializeAsSinglePrecisionFloat=True),FriendlyName="Arc Height",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="UIMin",DataValue="0.05"),(DataKey="UIMax",DataValue="0.95"),(DataKey="tooltip",DataValue="Here we can modify the height of the predicted launch path.")))
   NewVariables(10)=(VarName="Simulation Time",VarGuid=D56B8C524383F287BC3ED1860B8DEDF6,VarType=(PinCategory="real",PinSubCategory="double",bSerializeAsSinglePrecisionFloat=True),FriendlyName="Simulation Time",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Increasing this value will prolong the simulation used to predict the launch path. It can be increased if the predicted path stops simulating, for example when the ring is placed far from the destination or the height of the arc travels a great distance (and stops simulating).")))
   NewVariables(11)=(VarName="Simulation Frequency",VarGuid=8FDC28AB4FD25B338F9C84B7EF84567B,VarType=(PinCategory="real",PinSubCategory="double",bSerializeAsSinglePrecisionFloat=True),FriendlyName="Simulation Frequency",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Increasing this value will increase the number of steps (trace points) used during the simulation. You will notice the predicted path instance meshes getting closer.")))
   NewVariables(12)=(VarName="MovementInputBehavior",VarGuid=974A8B984EA2F2A8A543B880F1E15CD7,VarType=(PinCategory="byte",PinSubCategoryObject="/Script/Engine.UserDefinedEnum'/Game/CodeX_Restruct/Frameworks/TraversalDeviceFramework/Core/Enums/InputBehavior_Enum.InputBehavior_Enum'"),FriendlyName="Movement Input Behavior",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Select if you would like to ignore or not the movement input while launching the character. Ignoring it will restore it after landing.")))
   NewVariables(13)=(VarName="CharacterLaunchPosition",VarGuid=EA21146948389CC7430A08B972002D50,VarType=(PinCategory="byte",PinSubCategoryObject="/Script/Engine.UserDefinedEnum'/Game/CodeX_Restruct/Frameworks/TraversalDeviceFramework/Core/Enums/LaunchLocation_Enum.LaunchLocation_Enum'"),FriendlyName="Character Launch Position",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Selecting Closest Point From Spline will move the character to the spline\'s closest point before launching, so instead of moving them to the center of the box collision, we chose the closest middle point. // Selecting Character Overlap Location will not move the character and just launch them form the location of the initial overlap (current location). // Selecting Box Collision World Location will move the character to the center of the box collision before launching them. Useful when trying to follow perfectly the predicted launch path (from the center of the box collision).")))
   NewVariables(14)=(VarName="DestinationMeshHidden?",VarGuid=420AE7AE4E34C406DDC45889CEEEC06D,VarType=(PinCategory="bool"),FriendlyName="Destination Mesh Hidden?",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Set this True to hide in game the destination mesh (at the end of the predicted launch path).")))
