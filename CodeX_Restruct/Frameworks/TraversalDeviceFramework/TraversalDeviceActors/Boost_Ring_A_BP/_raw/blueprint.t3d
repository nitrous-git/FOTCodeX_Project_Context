   NewVariables(17)=(VarName="Custom Y (Pitch)",VarGuid=A573E67D43F09B465C46708677B026C4,VarType=(PinCategory="real",PinSubCategory="double",bSerializeAsSinglePrecisionFloat=True),FriendlyName="Custom Y (Pitch)",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Custom pitch value used if custom ring rotation is enabled.")))
