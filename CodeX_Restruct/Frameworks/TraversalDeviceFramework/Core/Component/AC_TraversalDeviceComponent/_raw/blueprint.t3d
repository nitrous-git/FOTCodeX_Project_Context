      Begin Object Name="EdGraphNode_Comment_73" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/TraversalDeviceFramework/Core/Component/AC_TraversalDeviceComponent.AC_TraversalDeviceComponent:EventGraph.EdGraphNode_Comment_73'"
         bCommentBubbleVisible_InDetailsPanel=False
         NodePosX=-33712
         NodePosY=19024
         NodeWidth=1760
         NodeHeight=944
         bCommentBubblePinned=False
         bCommentBubbleVisible=False
         NodeComment="Both events are active only if the component is ticking. They fire after landing or hitting an object. We then follow the corresponding section depending on the type of platformer actor that was used."
         NodeGuid=0E8AB07448B39158ADC6A7A9B4B8F4DD
      End Object
      Begin Object Name="EdGraphNode_Comment_60" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/TraversalDeviceFramework/Core/Component/AC_TraversalDeviceComponent.AC_TraversalDeviceComponent:EventGraph.EdGraphNode_Comment_60'"
         bCommentBubbleVisible_InDetailsPanel=False
         NodePosX=-31104
         NodePosY=18784
         NodeWidth=5648
         NodeHeight=800
         bCommentBubblePinned=False
         bCommentBubbleVisible=False
         NodeComment="If we hit an object while using the jump up spring, the Unique ID will be cleared and an animation will play."
         NodeGuid=E1C9BC114234A0939F66B887705E573E
      End Object
      Begin Object Name="EdGraphNode_Comment_82" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/TraversalDeviceFramework/Core/Component/AC_TraversalDeviceComponent.AC_TraversalDeviceComponent:EventGraph.EdGraphNode_Comment_82'"
         bCommentBubbleVisible_InDetailsPanel=False
         NodePosX=-31104
         NodePosY=19712
         NodeWidth=4352
         NodeHeight=1040
         bCommentBubblePinned=False
         bCommentBubbleVisible=False
         NodeComment="We check if the capsule is overlapping another platformer actor box / sphere collision just after landing, because sometimes, while landing very fast, the land event is triggered before the overlap event, preventing the use of another platformer actor immediately."
         NodeGuid=C8BAF3B04BCA80B6B3F96FAEF68D5187
      End Object
      Begin Object Name="EdGraphNode_Comment_62" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/TraversalDeviceFramework/Core/Component/AC_TraversalDeviceComponent.AC_TraversalDeviceComponent:EventGraph.EdGraphNode_Comment_62'"
         bCommentBubbleVisible_InDetailsPanel=False
         NodePosX=-31104
         NodePosY=20896
         NodeWidth=1376
         NodeHeight=624
         bCommentBubblePinned=False
         bCommentBubbleVisible=False
         NodeComment="When the variable -Update Axis Value?- is False, we are repositioning the character, so we don\'t interrupt it, even if the character registers a land event. But if the variable is True, then we can stop momentum if the character hits an object and restore the Braking Deceleration Falling and Falling Lateral Friction values in case they where modified previously."
         NodeGuid=761DC47A452BD746BA93B89CE6AF339F
      End Object
