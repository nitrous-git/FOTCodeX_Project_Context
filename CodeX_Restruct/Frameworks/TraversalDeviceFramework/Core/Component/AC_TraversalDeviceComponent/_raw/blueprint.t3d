      Begin Object Name="EdGraphNode_Comment_37" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/TraversalDeviceFramework/Core/Component/AC_TraversalDeviceComponent.AC_TraversalDeviceComponent:EventGraph.EdGraphNode_Comment_37'"
         bCommentBubbleVisible_InDetailsPanel=False
         CommentDepth=-2
         NodePosX=-25920
         NodePosY=8976
         NodeWidth=2480
         NodeHeight=864
         bCommentBubblePinned=False
         bCommentBubbleVisible=False
         NodeComment="First, we must ignore movement input while repositioning the character. Then we select the spline data. It is used in case we want to move the character to the closest point of the spline before launching. This is useful because, instead of moving the character to the center of the box collision, we can move them to a point near the center (using the spline as reference) so it takes less time to reach that location and the camera movement isn\'t affected as much because of the repositioning."
         NodeGuid=904037934EC3F82FFFA1F2A25C9C6DE8
      End Object
      Begin Object Name="EdGraphNode_Comment_38" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/TraversalDeviceFramework/Core/Component/AC_TraversalDeviceComponent.AC_TraversalDeviceComponent:EventGraph.EdGraphNode_Comment_38'"
         bCommentBubbleVisible_InDetailsPanel=False
         NodePosX=-24464
         NodePosY=9152
         NodeWidth=928
         NodeHeight=608
         bCommentBubblePinned=False
         bCommentBubbleVisible=False
         NodeComment="We get the target location from a vector saved as tag data in the platformer actor. It is the platformer actor world location, so the character smoothly updates its rotation before launching."
         NodeGuid=D3D4030E47F7AC60558440BB2EFB92FD
      End Object
