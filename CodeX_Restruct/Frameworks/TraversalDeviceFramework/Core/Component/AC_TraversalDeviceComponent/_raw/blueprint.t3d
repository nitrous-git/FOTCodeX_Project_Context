      Begin Object Name="EdGraphNode_Comment_36" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/TraversalDeviceFramework/Core/Component/AC_TraversalDeviceComponent.AC_TraversalDeviceComponent:EventGraph.EdGraphNode_Comment_36'"
         bCommentBubbleVisible_InDetailsPanel=False
         CommentDepth=-2
         NodePosX=-23264
         NodePosY=8976
         NodeWidth=2800
         NodeHeight=864
         bCommentBubblePinned=False
         bCommentBubbleVisible=False
         NodeComment="When using the jump pad, we set the character rotation first so they face the same direction. Then we save the jump pad pitch rotation value (from the actor tag float data). It will be used to smoothly rotate the character before launching."
         NodeGuid=7451D5F346FEA3E2548F4B9F50167481
      End Object
      Begin Object Name="EdGraphNode_Comment_40" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/TraversalDeviceFramework/Core/Component/AC_TraversalDeviceComponent.AC_TraversalDeviceComponent:EventGraph.EdGraphNode_Comment_40'"
         bCommentBubbleVisible_InDetailsPanel=False
         NodePosX=-20240
         NodePosY=8624
         NodeWidth=1680
         NodeHeight=1024
         bCommentBubblePinned=False
         bCommentBubbleVisible=False
         NodeComment="Here we change the capsule half size and radius before launching, so we make it smaller so it doesn\'t collide with other objects while repositioning. We restore its height and radius after there are no objects near the capsule or when landing / hitting an object."
         NodeGuid=83AE5A964BD21439FD8345BB098070C6
      End Object
      Begin Object Name="EdGraphNode_Comment_86" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/TraversalDeviceFramework/Core/Component/AC_TraversalDeviceComponent.AC_TraversalDeviceComponent:EventGraph.EdGraphNode_Comment_86'"
         bCommentBubbleVisible_InDetailsPanel=False
         NodePosX=-18464
         NodePosY=8624
         NodeWidth=2464
         NodeHeight=624
         bCommentBubblePinned=False
         bCommentBubbleVisible=False
         NodeComment="Here we set the character location so it faces the landing point. This path skips repositioning the character so we do this in this frame (immediately). We then set True to Update the Axis Value because we don\'t need to update the characters location as we are using its current location to launch them. After that, we enable this components tick."
         NodeGuid=57959C124E58852638BBFC9CF66212F5
      End Object
      Begin Object Name="EdGraphNode_Comment_85" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/TraversalDeviceFramework/Core/Component/AC_TraversalDeviceComponent.AC_TraversalDeviceComponent:EventGraph.EdGraphNode_Comment_85'"
         bCommentBubbleVisible_InDetailsPanel=False
         NodePosX=-27424
         NodePosY=27744
         NodeWidth=1296
         NodeHeight=720
         bCommentBubblePinned=False
         bCommentBubbleVisible=False
         NodeComment="Before launching the character we set its location at the Launch Location and also update its rotation so they face the landing point."
         NodeGuid=A34E81BC4B01D9BD5227429C90709EF1
      End Object
      Begin Object Name="EdGraphNode_Comment_71" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/TraversalDeviceFramework/Core/Component/AC_TraversalDeviceComponent.AC_TraversalDeviceComponent:EventGraph.EdGraphNode_Comment_71'"
         bCommentBubbleVisible_InDetailsPanel=False
         NodePosX=-26416
         NodePosY=29152
         NodeWidth=2176
         NodeHeight=1184
         bCommentBubblePinned=False
         bCommentBubbleVisible=False
         NodeComment="Here we reposition the character before launching, so they move to the launch point and also face the landing location. If using the jump pad, we can decide if we want to move the character to the middle of the pad or a close point relative to its location before overlaping the box collision. When using arc spring or rings, we can choose if the character moves to the center of the box collision or a closer point using the spline as reference."
         NodeGuid=9079D4724B3822CA0A03208C5A325341
      End Object
