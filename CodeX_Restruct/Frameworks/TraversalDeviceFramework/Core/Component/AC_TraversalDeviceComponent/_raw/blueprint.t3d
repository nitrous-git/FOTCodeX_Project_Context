      Begin Object Name="EdGraphNode_Comment_32" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/TraversalDeviceFramework/Core/Component/AC_TraversalDeviceComponent.AC_TraversalDeviceComponent:EventGraph.EdGraphNode_Comment_32'"
         NodePosX=-33792
         NodePosY=11376
         NodeWidth=3072
         NodeHeight=1712
         NodeComment="We use the spline data to modify the launch location if we want to use the closest point of the spline relative to the location of the character. If not, we use the central location of the box collision (for arc springs and rings)"
         NodeGuid=9362446D45DB8D52301F44A30D26B2AB
      End Object
      Begin Object Name="EdGraphNode_Comment_53" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/TraversalDeviceFramework/Core/Component/AC_TraversalDeviceComponent.AC_TraversalDeviceComponent:EventGraph.EdGraphNode_Comment_53'"
         bCommentBubbleVisible_InDetailsPanel=False
         NodePosX=-33120
         NodePosY=20096
         NodeWidth=1168
         NodeHeight=672
         bCommentBubblePinned=False
         bCommentBubbleVisible=False
         NodeComment="We use this animation montage to stop any other montage that is currently playing. In this example, we play a montage first, before using the -Montage Stop- function, because this particular animation has Blend In and Out values set at 0. We need them at 0 (even if we set 0 in the -In Blend Out Time- selection below) for other animations to stop immediately. If not, you will notice them blending out with a delay (and not immediately, like we need here)."
         NodeGuid=F1FFB526441E7E7C3E133EABFD836312
      End Object
      Begin Object Name="EdGraphNode_Comment_54" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/TraversalDeviceFramework/Core/Component/AC_TraversalDeviceComponent.AC_TraversalDeviceComponent:EventGraph.EdGraphNode_Comment_54'"
