         NodePosY=13744
         NodeWidth=2496
         NodeHeight=432
         bCommentBubblePinned=False
         bCommentBubbleVisible=False
         NodeComment="To prevent the capsule from colliding with other objects in the world while repositioning the character, we set its radius and half height to 5 until no objects are near the capsules normal size. We quickly restore its size after a short period of time or after landing / hitting an object."
         NodeGuid=6E6DF6074F4A565D7B5357AAF8D12DBC
      End Object
      Begin Object Name="EdGraphNode_Comment_49" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/CodeX_Restruct/Frameworks/TraversalDeviceFramework/Core/Component/AC_TraversalDeviceComponent.AC_TraversalDeviceComponent:EventGraph.EdGraphNode_Comment_49'"
