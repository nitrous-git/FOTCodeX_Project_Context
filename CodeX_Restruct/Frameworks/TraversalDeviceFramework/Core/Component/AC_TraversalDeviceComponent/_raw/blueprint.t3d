         NodeWidth=4080
         NodeHeight=1040
         bCommentBubblePinned=False
         bCommentBubbleVisible=False
         NodeComment="We check if there are no objects near the capsule that can collide with it before restoring its original size. If the character lands before restoring its size, we do so immediately by triggering the event -Pause Capsule Check- after landing."
         NodeGuid=AD075855427011177A620D848C611FA5
      End Object
