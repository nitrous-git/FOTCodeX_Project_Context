   NewVariables(1)=(VarName="CapsuleComponent",VarGuid=86D03B8E4AE62B64781334BD6B63859B,VarType=(PinCategory="object",PinSubCategoryObject="/Script/CoreUObject.Class'/Script/Engine.CapsuleComponent'"),FriendlyName="Capsule Component",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=65541,MetaDataArray=((DataKey="MultiLine",DataValue="true")))
   NewVariables(2)=(VarName="SkeletalMeshComponent",VarGuid=690A56C7487AFFD690E6E3B479BB71FC,VarType=(PinCategory="object",PinSubCategoryObject="/Script/CoreUObject.Class'/Script/Engine.SkeletalMeshComponent'"),FriendlyName="Skeletal Mesh Component",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=65541,MetaDataArray=((DataKey="MultiLine",DataValue="true")))
   NewVariables(3)=(VarName="ProjectGravity",VarGuid=88D4215F480CDF30632C1B915F4F5CE2,VarType=(PinCategory="real",PinSubCategory="double",bSerializeAsSinglePrecisionFloat=True),FriendlyName="Project Gravity",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="In the Project Settings we can find a value named Default Gravity Z. It is -980 by default. If we need to change that value, also change this float value so it matches the one from the project. For example, if the new value is -850, here we add 850.")))
   NewVariables(4)=(VarName="PlayAnimations?",VarGuid=69CCE2204E2B283467BF27BF3D777B2D,VarType=(PinCategory="bool"),FriendlyName="Play Animations?",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="If True then animations will play while using Platformer Actors. We can set this False if we only want to use the launch predictions without animations.")))
   NewVariables(5)=(VarName="UseDiveSpins?",VarGuid=3474033643EEF541813414BAC7610D86,VarType=(PinCategory="bool"),FriendlyName="Use Dive Spins?",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="While diving and reaching a pitch value lower than 0, the character will spin and end the current diving animation following a fall loop animation. Set this False if you would like to keep playing the diving animations regardless of the rotation angle.")))
   NewVariables(6)=(VarName="UseMirrorLandRecovAnim?",VarGuid=4B3BBDA94308A0CF1B7EE6A5DFAEC61E,VarType=(PinCategory="bool"),FriendlyName="Use Mirror Land Recov Anim?",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Play a mirrored Land Recovery 2 animation? It will play after landing while the movement input is registered. Set this True in case one of them blends better than the other.")))
   NewVariables(7)=(VarName="AdjustFallingParameters?",VarGuid=B1E76B9E4CE28225E309F782A034D3EE,VarType=(PinCategory="bool"),FriendlyName="Adjust Falling Parameters?",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Set this True to modify the Braking Deceleration Falling and Falling Lateral Friction values. Both will be set to 0 while launching the Character. We then restore their previous values after landing. We do this because both parameters prevent us from predicting accurately the launch velocity.")))
   NewVariables(8)=(VarName="AdjustCapsuleSize?",VarGuid=8412F9C44C417DE0257FA3897ECF04E3,VarType=(PinCategory="bool"),FriendlyName="Adjust Capsule Size?",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Set this True to adjust the Half Height and Radius of the Capsule Component while interacting with Springs, Ziplines, Rings and Jump Pads. It is True by default and necessary for the component to work as expected. The size of the Capsule will be reduced for a brief moment while repositioning the Character before launching, so it doesn\'t collide with other nearby objects.")))
   NewVariables(9)=(VarName="ShowHitReactions?",VarGuid=872E07BC4066171CCC3E1380EBF8EBD0,VarType=(PinCategory="bool"),FriendlyName="Show Hit Reactions?",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="If True and if animations are active then a Hit animation will play after hitting an object midair.")))
   NewVariables(10)=(VarName="LaunchUpwardAfterHit?",VarGuid=C1187FDD44420E59245C039727BD5A70,VarType=(PinCategory="bool"),FriendlyName="Launch Upward After Hit?",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Launch the Character upward after hitting an object midair? Won\'t happen while using Jump Up Springs and Ziplines.")))
   NewVariables(11)=(VarName="UpwardsVelocity OnHit",VarGuid=43E85AF64A3CECB5E226DB84D8981E56,VarType=(PinCategory="real",PinSubCategory="double",bSerializeAsSinglePrecisionFloat=True),FriendlyName="Upwards Velocity on Hit",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Force applied after hitting an object midair and while following the predicted launch path (arc). This won\'t happen while using Jump Up Springs and Ziplines.")))
   NewVariables(12)=(VarName="RestoreInputAfterHit?",VarGuid=F5EF0C5B4F48A9FA4F27729DA728A3AC,VarType=(PinCategory="bool"),FriendlyName="Restore Input After Hit?",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Restore movement input after hitting an object midair?")))
   NewVariables(13)=(VarName="HitCameraShake",VarGuid=2B728A0544F239313AB149B4717B8328,VarType=(PinCategory="class",PinSubCategoryObject="/Script/CoreUObject.Class'/Script/Engine.CameraShakeBase'",bIsUObjectWrapper=True),FriendlyName="Hit Camera Shake",Category=NSLOCTEXT("KismetSchema", "Default", "Default"),PropertyFlags=5,MetaDataArray=((DataKey="MultiLine",DataValue="true"),(DataKey="tooltip",DataValue="Plays when Show Hit Reactions? is True."),(DataKey="ExposeOnSpawn",DataValue="true")))
